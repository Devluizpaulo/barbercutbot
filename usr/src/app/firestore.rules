/**
 * @fileOverview Firestore Security Rules for the Barber Shop SaaS application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and barber shops.
 * Subcollections under barber shops are accessible only to the barber shop owner.
 * Platform-level data (legal documents and support tickets) have more permissive access based on roles or specific criteria.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the owning user.
 * - /barberShops/{barberShopId}: Stores barber shop data, accessible only to the shop owner.
 * - /barberShops/{barberShopId}/[...]: Subcollections under barber shops are accessible only to the shop owner.
 * - /tickets/{ticketId}: Stores support tickets, accessible to shop owner and potentially admins.
 * - /documents/{documentId}: Stores platform-wide legal documents; access may be public or admin-restricted.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Barber shop data is accessible only to the shop owner.
 * - Listing of users is disallowed to prevent enumeration.
 * - Subcollections inherit the ownership of their parent barber shop.
 * - Super-user "admin" role is not implemented, but is reserved for potential future use.
 * - Validation is focused on authorization and relational integrity, not on full schema enforcement.
 *
 * Denormalization for Authorization:
 * - The `ownerId` field in the `barberShops` collection is used to quickly determine ownership without additional reads.
 * - Subcollections under `/barberShops/{barberShopId}` implicitly denormalize `barberShopId` in the path.
 *
 * Structural Segregation:
 * - There are no public vs. private data scenarios requiring structural segregation in the current model. All user and barber shop data is considered private.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     * @returns {boolean} True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the given user ID.
     * @param {string} userId - The user ID to check against.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner and the resource exists.
     * @param {string} userId - The user ID to check against.
     * @returns {boolean} True if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rule for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - A user can create their own profile if the userId matches their auth UID.
     * @allow (get, list) - A user can read their own profile.
     * @deny (create) - A user cannot create a profile for another user.
     * @deny (update, delete) - A user cannot modify or delete another user's profile.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /barberShops/{barberShopId} collection.
     * @path /barberShops/{barberShopId}
     * @allow (create) - A user can create a barber shop if they are the owner.
     * @allow (get, list) - Any authenticated user can read a barber shop's data.
     * @deny (create) - A user cannot create a barber shop for another user.
     * @deny (update, delete) - Only the owner can modify or delete a barber shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /barberShops/{barberShopId}/products/{productId} collection.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) - Only the barber shop owner can create a product.
     * @allow (get, list) - Any authenticated user can read a product.
     * @deny (update, delete) - Only the owner can modify or delete a product.
     * @principle Enforces ownership via the parent barber shop's ownerId.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /barberShops/{barberShopId}/customers/{customerId} collection.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) - Only the barber shop owner can create a customer.
     * @allow (get, list) - Any authenticated user can read a customer.
     * @deny (update, delete) - Only the owner can modify or delete a customer.
     * @principle Enforces ownership via the parent barber shop's ownerId.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /barberShops/{barberShopId}/barbers/{barberId} collection.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) - Only the barber shop owner can create a barber.
     * @allow (get, list) - Any authenticated user can read a barber.
     * @deny (update, delete) - Only the owner can modify or delete a barber.
     * @principle Enforces ownership via the parent barber shop's ownerId.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /barberShops/{barberShopId}/appointments/{appointmentId} collection.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) - Only the barber shop owner can create an appointment.
     * @allow (get, list) - Any authenticated user can read an appointment.
     * @deny (update, delete) - Only the owner can modify or delete an appointment.
     * @principle Enforces ownership via the parent barber shop's ownerId.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /barberShops/{barberShopId}/services/{serviceId} collection.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) - Only the barber shop owner can create a service.
     * @allow (get, list) - Any authenticated user can read a service.
     * @deny (update, delete) - Only the owner can modify or delete a service.
     * @principle Enforces ownership via the parent barber shop's ownerId.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /barberShops/{barberShopId}/suppliers/{supplierId} collection.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) - Only the barber shop owner can create a supplier.
     * @allow (get, list) - Any authenticated user can read a supplier.
     * @deny (update, delete) - Only the owner can modify or delete a supplier.
     * @principle Enforces ownership via the parent barber shop's ownerId.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /barberShops/{barberShopId}/financialRecords/{financialRecordId} collection.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) - Only the barber shop owner can create a financialRecord.
     * @allow (get, list) - Any authenticated user can read a financialRecord.
     * @deny (update, delete) - Only the owner can modify or delete a financialRecord.
     * @principle Enforces ownership via the parent barber shop's ownerId.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /tickets/{ticketId} collection.
     * @path /tickets/{ticketId}
     * @allow (get, list) - Any signed-in user can read the ticket.
     * @allow (create) - Any signed-in user can create a ticket.
     * @deny (update, delete) - Only the shop owner (creator) can update or delete a ticket.
     * @principle Allows all signed-in users to submit support tickets.
     */
     match /tickets/{ticketId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /documents/{documentId} collection.
     * @path /documents/{documentId}
     * @allow (get, list) - Any user can read the documents.
     * @deny (create, update, delete) - No user can create, update, or delete documents.
     * @principle Provides public read access to legal documents.
     */
    match /documents/{documentId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
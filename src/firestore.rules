
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Admin check prioritizes custom claims for performance.
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isShopOwner(shopId) {
      // This function uses `get`, so it's NOT suitable for broad `list` rules on the top-level collection.
      // It is safe for operations within a specific shop's path.
      return isSignedIn() && 
        exists(/databases/$(database)/documents/barberShops/$(shopId)) &&
        get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // ADMIN GOD-MODE (HIGHEST PRIORITY)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // =============================================
    // USER & SHOP-LEVEL RULES
    // =============================================

    match /users/{userId} {
      // A user can create their own profile document and then read/update it.
      allow create, read, update: if request.auth.uid == userId;
    }

    match /barberShops/{shopId} {
      // A user can create a shop only if they set themselves as the owner.
      allow create: if request.auth.uid == request.resource.data.ownerId;
      
      // The shop owner can read, update, or delete their own shop document.
      allow read, update, delete: if isShopOwner(shopId);
      
      // A user can only list shops that they own. This requires a client-side query constraint.
      allow list: if isSignedIn() && request.query.where[0] == 'ownerId' && request.query.where[2] == request.auth.uid;
    }
    
    // ====================================================================
    // SIMPLIFIED SUB-COLLECTION RULE (THE FINAL FIX)
    // ====================================================================
    // This rule now applies to all operations within a shop's sub-collection,
    // including `list`. By using `isShopOwner`, we ensure that only the shop
    // owner can access their data, but we remove the complex client-side query
    // constraints that were causing the permission errors.
    match /barberShops/{shopId}/{subcollection}/{docId} {
      allow read, write: if isShopOwner(shopId);
    }
    
    // =============================================
    // PLATFORM-WIDE COLLECTIONS
    // =============================================

    match /adminLogs/{logId} {
      // Creating logs is allowed for any signed-in user to capture failed auth attempts.
      allow create: if isSignedIn();
      // Only admins can read or write (in practice, only create via helper function)
      allow read, write: if isAdmin();
    }

    match /tickets/{ticketId} {
      // User can create their own ticket.
      allow create: if request.auth.uid == request.resource.data.userId;
      // Owner of ticket or admin can read/write.
      allow read, write: if request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId || isAdmin();
    }

    match /stripeEventsProcessed/{eventId} {
      // Only the trusted server process (with admin credentials) can write here.
      allow create: if isAdmin();
    }
  }
}

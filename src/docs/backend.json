
{
  "entities": {
    "BarberShop": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BarberShop",
      "type": "object",
      "description": "Represents a barber shop within the SaaS application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "logo": { "type": "string", "format": "uri" },
        "address": { "type": "string" },
        "number": { "type": "string" },
        "complement": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "cep": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "document": { "type": "string" },
        "contactPerson": { "type": "string" },
        "instagram": { "type": "string", "format": "uri" },
        "facebook": { "type": "string", "format": "uri" },
        "website": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "workingHours": { "type": "array", "items": { "$ref": "#/entities/WorkingHour" } },
        "holidays": { "type": "array", "items": { "$ref": "#/entities/Holiday" } },
        "paymentSettings": { "type": "array", "items": { "$ref": "#/entities/PaymentMethod" } },
        "cashierSettings": { "$ref": "#/entities/CashierSettings" },
        "roles": { "type": "array", "items": { "$ref": "#/entities/Role" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "subscription": { "$ref": "#/entities/Subscription" },
        "whatsapp": { "$ref": "#/entities/WhatsappConfig" },
        "bot": { "$ref": "#/entities/BotConfig" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "UserProfile": {
        "title": "User Profile",
        "description": "Represents any user in the system, stored in a global /users collection.",
        "type": "object",
        "properties": {
            "id": { "type": "string", "description": "Matches Firebase Auth UID." },
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "role": { "type": "string", "enum": ["admin", "owner", "staff"], "description": "Global role of the user." },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "email", "role"]
    },
    "TeamMember": {
        "title": "Team Member",
        "description": "Represents a user's membership and role within a specific shop. Stored in /barberShops/{shopId}/team/{userId}",
        "type": "object",
        "properties": {
            "userId": { "type": "string", "description": "UID of the user from the global /users collection." },
            "shopId": { "type": "string", "description": "ID of the barber shop." },
            "roleId": { "type": "string", "description": "The role ID from the shop's 'roles' array." },
            "joinedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "shopId", "roleId"]
    },
    "Appointment": { "type": "object", "properties": {} },
    "Customer": { "type": "object", "properties": {} },
    "Barber": { "type": "object", "properties": {} },
    "Service": { "type": "object", "properties": {} },
    "Product": { "type": "object", "properties": {} },
    "FinancialRecord": { "type": "object", "properties": {} },
    "Supplier": { "type": "object", "properties": {} },
    "Ticket": { "type": "object", "properties": {} },
    "Document": { "type": "object", "properties": {} },
    "WorkingHour": { "type": "object", "properties": {} },
    "Holiday": { "type": "object", "properties": {} },
    "PaymentMethod": { "type": "object", "properties": {} },
    "CashierSettings": { "type": "object", "properties": {} },
    "Role": { "type": "object", "properties": {} },
    "Subscription": { "type": "object", "properties": {} },
    "WhatsappConfig": { "type": "object", "properties": {} },
    "BotConfig": { "type": "object", "properties": {} }
  },
  "auth": {
    "providers": ["password", "anonymous"],
    "customClaims": {
        "admin": {
            "type": "boolean",
            "description": "Grants god-mode access to all Firestore data. Should be set via a Cloud Function when a user's role in the /users collection is set to 'admin'."
        }
    }
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "schema": { "$ref": "#/entities/UserProfile" } }
      },
      {
        "path": "/barberShops/{shopId}",
        "definition": { "schema": { "$ref": "#/entities/BarberShop" } }
      },
      {
        "path": "/barberShops/{shopId}/team/{userId}",
        "definition": { "schema": { "$ref": "#/entities/TeamMember" }, "description": "Sub-collection listing all staff members of a shop. The document ID is the user's UID." }
      },
      { "path": "/barberShops/{shopId}/products/{productId}", "definition": { "schema": { "$ref": "#/entities/Product" } } },
      { "path": "/barberShops/{shopId}/customers/{customerId}", "definition": { "schema": { "$ref": "#/entities/Customer" } } },
      { "path": "/barberShops/{shopId}/barbers/{barberId}", "definition": { "schema": { "$ref": "#/entities/Barber" } } },
      { "path": "/barberShops/{shopId}/appointments/{appointmentId}", "definition": { "schema": { "$ref": "#/entities/Appointment" } } },
      { "path": "/barberShops/{shopId}/services/{serviceId}", "definition": { "schema": { "$ref": "#/entities/Service" } } },
      { "path": "/barberShops/{shopId}/suppliers/{supplierId}", "definition": { "schema": { "$ref": "#/entities/Supplier" } } },
      { "path": "/barberShops/{shopId}/financialRecords/{financialRecordId}", "definition": { "schema": { "$ref": "#/entities/FinancialRecord" } } },
      { "path": "/tickets/{ticketId}", "definition": { "schema": { "$ref": "#/entities/Ticket" } } },
      { "path": "/documents/{documentId}", "definition": { "schema": { "$ref": "#/entities/Document" } } }
    ]
  }
}

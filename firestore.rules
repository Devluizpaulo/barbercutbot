/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset enforces a multi-tenant security model for a Barber Shop SaaS application.
 * Data is primarily segregated by BarberShop, with access control based on ownership and explicit relationships.
 * @data-structure
 * - /users/{userId}: User profiles, owned by the user.
 * - /admins/{adminId}: List of admin user IDs.
 * - /barberShops/{barberShopId}: Barber shop data, owned by a user (ownerId).
 * - /barberShops/{barberShopId}/[...]: Subcollections related to a specific barber shop.
 * - /tickets/{ticketId}: Support tickets, accessible with specific ownership.
 * - /documents/{documentId}: Platform-wide legal documents, publicly readable.
 * @key-security-decisions
 * - Users can only manage their own profiles.
 * - Barber shop data is primarily managed by the shop owner.
 * - Subcollections under barberShops inherit the shop's access control, with writes restricted to the shop owner.
 * - Listing all documents at the root is denied to all users.
 * @denormalization-for-authorization The `barberShopId` is denormalized (copied) into documents within the `/barberShops/{barberShopId}` subcollections. This simplifies and secures queries and writes by avoiding the need for expensive `get()` calls in the rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verifies user authentication.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces ownership-based access control.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces ownership-based access control and resource existence.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Match root level and deny all listing.
     * @path /
     * @allow none
     * @deny (list) any authenticated user.
     * @principle Prevent open access.
     */
    match /{document=**} {
      allow list: if false;
    }

    /**
     * @description Manages user profiles. Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) authenticated user creates their own profile
     * @allow (get, update, delete) authenticated user reads/modifies their own profile
     * @deny (create) authenticated user tries to create another user's profile
     * @deny (get, update, delete) authenticated user tries to read/modify another user's profile
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages admin user IDs. Only admins can manage this collection.
     * @path /admins/{adminId}
     * @allow (create, get, update, delete) Admin user creates, reads, updates, or deletes an admin profile.
     * @deny (create, get, update, delete) Non-admin user attempts to perform any operation.
     * @principle Enforces role-based access control.
     */
    match /admins/{adminId} {
        allow get: if true; // TODO: Replace with admin check
        allow list: if false;
        allow create: if false; // TODO: Replace with admin check
        allow update: if false; // TODO: Replace with admin check
        allow delete: if false; // TODO: Replace with admin check
    }

    /**
     * @description Manages barber shop data. Only the owner of the barber shop can create, read, update, or delete it.
     * @path /barberShops/{barberShopId}
     * @allow (create) authenticated user creates a barber shop and is set as the owner.
     * @allow (get, update, delete) owner of the barber shop reads, updates, or deletes the shop.
     * @deny (create, get, update, delete) non-owner attempts to perform any operation.
     * @principle Enforces document ownership for all write operations.
     */
    match /barberShops/{barberShopId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if resource.data.ownerId == request.auth.uid && resource != null;
      allow delete: if resource.data.ownerId == request.auth.uid && resource != null;

      /**
       * @description Manages products for a specific barber shop. Only the owner of the barber shop can create, read, update, or delete products.
       * @path /barberShops/{barberShopId}/products/{productId}
       * @allow (create, get, update, delete) owner of the barber shop creates, reads, updates, or deletes products.
       * @deny (create, get, update, delete) non-owner attempts to perform any operation.
       * @principle Enforces document ownership for all write operations.
       */
      match /products/{productId} {
        allow get: if true;
        allow list: if true;
        allow create: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Manages customers for a specific barber shop. Only the owner of the barber shop can create, read, update, or delete customers.
       * @path /barberShops/{barberShopId}/customers/{customerId}
       * @allow (create, get, update, delete) owner of the barber shop creates, reads, updates, or deletes customers.
       * @deny (create, get, update, delete) non-owner attempts to perform any operation.
       * @principle Enforces document ownership for all write operations.
       */
      match /customers/{customerId} {
        allow get: if true;
        allow list: if true;
        allow create: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Manages barbers for a specific barber shop. Only the owner of the barber shop can create, read, update, or delete barbers.
       * @path /barberShops/{barberShopId}/barbers/{barberId}
       * @allow (create, get, update, delete) owner of the barber shop creates, reads, updates, or deletes barbers.
       * @deny (create, get, update, delete) non-owner attempts to perform any operation.
       * @principle Enforces document ownership for all write operations.
       */
      match /barbers/{barberId} {
        allow get: if true;
        allow list: if true;
        allow create: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Manages appointments for a specific barber shop. Only the owner of the barber shop can create, read, update, or delete appointments.
       * @path /barberShops/{barberShopId}/appointments/{appointmentId}
       * @allow (create, get, update, delete) owner of the barber shop creates, reads, updates, or deletes appointments.
       * @deny (create, get, update, delete) non-owner attempts to perform any operation.
       * @principle Enforces document ownership for all write operations.
       */
      match /appointments/{appointmentId} {
        allow get: if true;
        allow list: if true;
        allow create: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Manages services for a specific barber shop. Only the owner of the barber shop can create, read, update, or delete services.
       * @path /barberShops/{barberShopId}/services/{serviceId}
       * @allow (create, get, update, delete) owner of the barber shop creates, reads, updates, or deletes services.
       * @deny (create, get, update, delete) non-owner attempts to perform any operation.
       * @principle Enforces document ownership for all write operations.
       */
      match /services/{serviceId} {
        allow get: if true;
        allow list: if true;
        allow create: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Manages suppliers for a specific barber shop. Only the owner of the barber shop can create, read, update, or delete suppliers.
       * @path /barberShops/{barberShopId}/suppliers/{supplierId}
       * @allow (create, get, update, delete) owner of the barber shop creates, reads, updates, or deletes suppliers.
       * @deny (create, get, update, delete) non-owner attempts to perform any operation.
       */
      match /suppliers/{supplierId} {
        allow get: if true;
        allow list: if true;
        allow create: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Manages financial records for a specific barber shop. Only the owner of the barber shop can create, read, update, or delete financial records.
       * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
       * @allow (create, get, update, delete) owner of the barber shop creates, reads, updates, or deletes financial records.
       * @deny (create, get, update, delete) non-owner attempts to perform any operation.
       * @principle Enforces document ownership for all write operations.
       */
      match /financialRecords/{financialRecordId} {
        allow get: if true;
        allow list: if true;
        allow create: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }
    }

    /**
     * @description Manages support tickets.
     * @path /tickets/{ticketId}
     * @allow (create) authenticated user creates a support ticket.
     * @allow (get) any authenticated user can read the ticket.
     * @allow (update, delete) only the ticket creator can update or delete.
     * @deny (create, get, update, delete) unauthorized access.
     * @principle Enforces ownership for updates and deletes, allows public reads.
     */
    match /tickets/{ticketId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if resource.data.userId == request.auth.uid && resource != null;
      allow delete: if resource.data.userId == request.auth.uid && resource != null;
    }

     /**
      * @description Manages legal documents (e.g., Terms of Service).
      * @path /documents/{documentId}
      * @allow (get, list) publicly readable.
      * @allow (create, update, delete) requires admin privileges (TODO: Implement admin check).
      * @deny (create, update, delete) unauthorized access.
      * @principle Allows public reads, restricts writes to admins.
      */
    match /documents/{documentId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Implement admin check
      allow update: if false; // TODO: Implement admin check && resource != null;
      allow delete: if false; // TODO: Implement admin check && resource != null;
    }
  }
}
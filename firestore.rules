
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Custom claim is the single, most secure source of truth for admin access.
      // The frontend logic ensures the user's role is checked, but for security rules,
      // claims are faster and cannot be tampered with on the client.
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Checks if the user is the owner of a specific shop by looking at the ownerId field.
    function isShopOwner(shopId) {
        return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }
    
    // =============================================
    // USER AND SHOP RULES
    // =============================================

    match /users/{userId} {
      // A user can create their own document upon signup.
      allow create: if request.auth.uid == userId;
      // Users can read/write their own profile. Admins can do anything.
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    match /barberShops/{shopId} {
      // Only signed-in users can create a shop. The ownerId is validated by the client logic.
      allow create: if isSignedIn();
      // Admins or shop owners can read/update/delete a shop.
      allow read, update, delete: if isShopOwner(shopId) || isAdmin();

      // Rules for sub-collections within a barber shop
      match /{subcollection}/{docId} {
        // By default, only owner or admin can access sub-collections.
        allow read, write: if isShopOwner(shopId) || isAdmin();
      }
    }
    
    // =============================================
    // PLATFORM-WIDE COLLECTIONS
    // =============================================

    match /adminLogs/{logId} {
      allow create: if isSignedIn(); // Allows logging failed login attempts for existing users.
      allow read, list: if isAdmin();
      // No one can update or delete logs.
      allow update, delete: if false;
    }
    
    match /platform/{docId} {
      // Admins have full access.
      allow read, write: if isAdmin();
    }
    
    match /tickets/{ticketId} {
      // User can create a ticket for themselves.
      allow create: if request.auth.uid == request.resource.data.userId;
      // User can view their own ticket, or an admin can view any ticket.
      allow get, update: if get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
      // Admins can list all tickets, users can only list their own.
      allow list: if isAdmin() || (isSignedIn() && request.query.where[0] == 'userId' && request.query.where[2] == request.auth.uid);
    }
    
    match /documents/{documentId} {
        allow read: if true; // Public documents like terms of service.
        allow write: if isAdmin(); // Only admins can edit legal documents.
    }

    // Publicly readable pricing plans.
    match /platform/pricing/plans/{planId} {
        allow get, list: if true;
        allow write: if isAdmin();
    }
  }
}

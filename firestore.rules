rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper Functions
    // =============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the requesting user is the owner of a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks if the requesting user has an 'admin' role in their user document.
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Checks if the requesting user owns the parent barberShop.
    function ownsBarberShop(barberShopId) {
        return isAuthenticated() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // Global Admin Access
    // =============================================

    // Admins can read and write all documents. This rule is checked first.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // =============================================
    // User Collection Rules
    // =============================================
    match /users/{userId} {
      // Allows the /setup page to check if an admin exists, even without being authenticated.
      // This is safe because it ONLY allows a query on the 'role' field.
      allow list: if request.query.keys.hasOnly(['role']) && request.query.role == 'admin';
      
      // A user can read or write to their own document.
      allow read, write: if isOwner(userId);
      
      // An authenticated user can create their own user document.
      // This is essential for the /signup and /setup flows.
      allow create: if isAuthenticated() && request.resource.data.id == request.auth.uid;
    }

    // =============================================
    // BarberShop Collection and Sub-collections
    // =============================================
    match /barberShops/{barberShopId} {
      // Any authenticated user can create a new shop.
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      // Only the owner can manage their shop.
      allow read, update, delete: if ownsBarberShop(barberShopId);

      // Rule for all sub-collections within a barber shop
      match /{subCollection}/{docId} {
        // Allow read/write only if the user is the owner of the parent shop.
        allow read, write, delete: if ownsBarberShop(barberShopId);
      }
    }
    
    // =============================================
    // CPanel & System Collections
    // =============================================

    // Admin logs can be created by any authenticated user (to log failed attempts),
    // but only read by admins. They are immutable.
    match /adminLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    
    // Tickets can be created by any shop owner.
    // Only the owner who created it or an admin can read/update it.
    match /tickets/{ticketId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Legal documents can only be managed by admins.
     match /documents/{documentId} {
      allow read, write, delete: if isAdmin();
    }
  }
}

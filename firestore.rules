/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and barber shops.
 *   Barber shop data is segregated by shop ID, with ownership determined by the `ownerId` field.
 *   Nested collections under barber shops inherit this ownership model, with `barberShopId` denormalized in nested paths, 
 *   which are implicitly accessible for QAPs by owner and implicitly available on writes.
 *
 * @dataStructure
 *   - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 *   - /admins/{adminId}: Stores admin user IDs, accessible only to admins.
 *   - /barberShops/{barberShopId}: Stores barber shop data, accessible only to the shop owner.
 *   - /barberShops/{barberShopId}/[...]: Subcollections of barber shops, accessible only to the shop owner.
 *   - /tickets/{ticketId}: Stores support tickets, which have their own owner, and are accessible to the shop owner, the ticket owner and admins.
 *   - /documents/{documentId}: Stores platform-wide legal documents, publicly readable, and only writeable by admins.
 *
 * @keySecurityDecisions
 *   - User listing is disallowed.
 *   - All write operations require authentication.
 *   - Data validation is limited to relational integrity and ownership checks for prototyping.
 *
 * @denormalizationForAuthorization
 *   - The `barberShopId` is present in nested paths so nested collections are implicitly accessible for QAPs by owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     */
    function isExistingOwner(ownerId) {
        return isSignedIn() && request.auth.uid == ownerId && resource != null;
    }
    
    /**
     * @description Checks if the authenticated user is an admin.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile.
     * @allow (get) User with UID 'user123' can read their profile.
     * @deny (create) User with UID 'user123' cannot create a profile for 'user456'.
     * @deny (update) User with UID 'user123' cannot update 'user456' profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for admins.
     * @path /admins/{adminId}
     * @allow (create) Admin can create their profile.
     * @allow (get) Admin can read their profile.
     * @deny (create) Non-admin cannot create an admin profile.
     * @deny (update) Non-admin cannot update an admin profile.
     * @principle Restricts admin creation to other admins and requires authentication for all operations.
     */
    match /admins/{adminId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for barber shops.
     * @path /barberShops/{barberShopId}
     * @allow (create) User with UID 'user123' can create a barber shop with ownerId 'user123'.
     * @allow (get) User with UID 'user123' can read a barber shop they own.
     * @deny (create) User with UID 'user123' cannot create a barber shop with ownerId 'user456'.
     * @deny (update) User with UID 'user123' cannot update a barber shop they don't own.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /barberShops/{barberShopId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Rules for products within a barber shop.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) User with UID 'user123' can create a product in their barber shop.
     * @allow (get) Any signed-in user can get a product.
     * @deny (create) User with UID 'user123' cannot create a product in someone else's barber shop.
     * @deny (update) User with UID 'user123' cannot update a product in someone else's barber shop.
     * @principle Enforces ownership via barberShopId and restricts access to the shop owner.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Rules for customers within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) User with UID 'user123' can create a customer in their barber shop.
     * @allow (get) Any signed-in user can get a customer.
     * @deny (create) User with UID 'user123' cannot create a customer in someone else's barber shop.
     * @deny (update) User with UID 'user123' cannot update a customer in someone else's barber shop.
     * @principle Enforces ownership via barberShopId and restricts access to the shop owner.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Rules for barbers within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) User with UID 'user123' can create a barber in their barber shop.
     * @allow (get) Any signed-in user can get a barber.
     * @deny (create) User with UID 'user123' cannot create a barber in someone else's barber shop.
     * @deny (update) User with UID 'user123' cannot update a barber in someone else's barber shop.
     * @principle Enforces ownership via barberShopId and restricts access to the shop owner.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Rules for appointments within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) User with UID 'user123' can create an appointment in their barber shop.
     * @allow (get) Any signed-in user can get an appointment.
     * @deny (create) User with UID 'user123' cannot create an appointment in someone else's barber shop.
     * @deny (update) User with UID 'user123' cannot update an appointment in someone else's barber shop.
     * @principle Enforces ownership via barberShopId and restricts access to the shop owner.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Rules for services within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) User with UID 'user123' can create a service in their barber shop.
     * @allow (get) Any signed-in user can get a service.
     * @deny (create) User with UID 'user123' cannot create a service in someone else's barber shop.
     * @deny (update) User with UID 'user123' cannot update a service in someone else's barber shop.
     * @principle Enforces ownership via barberShopId and restricts access to the shop owner.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Rules for suppliers within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) User with UID 'user123' can create a supplier in their barber shop.
     * @allow (get) Any signed-in user can get a supplier.
     * @deny (create) User with UID 'user123' cannot create a supplier in someone else's barber shop.
     * @deny (update) User with UID 'user123' cannot update a supplier in someone else's barber shop.
     * @principle Enforces ownership via barberShopId and restricts access to the shop owner.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Rules for financial records within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) User with UID 'user123' can create a financial record in their barber shop.
     * @allow (get) Any signed-in user can get a financial record.
     * @deny (create) User with UID 'user123' cannot create a financial record in someone else's barber shop.
     * @deny (update) User with UID 'user123' cannot update a financial record in someone else's barber shop.
     * @principle Enforces ownership via barberShopId and restricts access to the shop owner.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }
    
    /**
     * @description Rules for support tickets.
     * @path /tickets/{ticketId}
     * @allow (create) User with UID 'user123' can create a ticket.
     * @allow (get) User with UID 'user123' can read a ticket if they are the owner, shop owner, or admin.
     * @deny (create) User with UID 'user123' cannot create a ticket for another user.
     * @deny (update) User with UID 'user123' cannot update a ticket they don't own, aren't the shop owner of, or aren't an admin.
     * @principle Allows ticket access to the owner, shop owner, and admins.
     */
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.userId || isExistingOwner(get(/databases/$(database)/documents/barberShops/$(resource.data.shopId)).data.ownerId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isExistingOwner(get(/databases/$(database)/documents/barberShops/$(resource.data.shopId)).data.ownerId) || isAdmin());
      allow delete: if false;
    }
        
   /**
     * @description Rules for platform-wide legal documents.
     * @path /documents/{documentId}
     * @allow (get) Any user can read published documents.
     * @deny (create) Only admins can create documents.
     * @deny (update) Only admins can update documents.
     * @principle Public read, admin-only write.
     */
    match /documents/{documentId} {
        allow get: if true;
        allow list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if false;
    }
  }
}
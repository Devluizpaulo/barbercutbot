
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user's UID is in the admins collection.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins can read and write all data across the platform.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Rules for user profiles
    match /users/{userId} {
      // Any authenticated user can create their own profile.
      allow create: if request.auth != null;
      // Users can only read, update, or delete their own profile.
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the main barberShops collection
    match /barberShops/{shopId} {
      // Any user can read shop details (for public profiles, listings, etc.).
      allow read: if true;
      // An authenticated user can create a shop, but must be its owner.
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      // Only the owner of a shop can update or delete it.
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Rules for subcollections within a barberShop
      match /{subcollection}/{docId} {
        // The owner of the shop can do anything within their shop's subcollections.
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
      }
    }
    
    // Rules for platform-wide collections (tickets, documents, admins)
    match /tickets/{ticketId} {
        // Admins can manage all tickets. Users can create tickets and read/update their own.
        allow read, update, delete: if isAdmin();
        allow create: if request.auth != null;
        allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /documents/{docId} {
        // Admins can manage all documents. Anyone can read them.
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
        // Only other admins can see or manage the list of admins.
        allow read, write: if isAdmin();
    }
  }
}

    
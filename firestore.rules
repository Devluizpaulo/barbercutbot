/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset enforces a multi-tenant security model for a barber shop SaaS application.
 * All data is segregated by barberShopId, ensuring that users can only access data associated with their barber shop.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /admins/{adminId}: Stores admin profiles, accessible only by admins.
 * - /barberShops/{barberShopId}: Stores barber shop data, accessible only by the shop owner.
 * - /barberShops/{barberShopId}/{collection}/{documentId}: Stores data related to a specific barber shop (e.g., customers, barbers, appointments), accessible only to the shop owner.
 * - /tickets/{ticketId}: Stores support tickets from all users/shops.
 * - /documents/{documentId}: Stores platform-wide legal documents.
 *
 * Key Security Decisions:
 * - Strict Ownership: Most collections enforce a strict ownership model, where only the owner (identified by userId or barberShopId) can read or write data.
 * - Denormalization: The barberShopId is denormalized into subcollections under /barberShops/{barberShopId} to simplify and optimize security rules.
 * - No User Listing: Listing all users is not permitted to protect user privacy.
 * - Admin Collection: The admins collection segregates admin users and allows admin-specific rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their own profile.
     * @allow (get) User with UID 'user_abc' can read their own profile.
     * @allow (update) User with UID 'user_abc' can update their own profile.
     * @allow (delete) User with UID 'user_abc' can delete their own profile.
     * @deny (create) User with UID 'user_xyz' cannot create a profile with ID 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Enforces admin-only access for admin profiles.
     * @path /admins/{adminId}
     * @allow (create) Admin with UID 'admin_abc' can create their own profile.
     * @allow (get) Admin with UID 'admin_abc' can read their own profile.
     * @allow (update) Admin with UID 'admin_abc' can update their own profile.
     * @allow (delete) Admin with UID 'admin_abc' can delete their own profile.
     * @deny (create) User with UID 'user_xyz' cannot create a profile with ID 'admin_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /admins/{adminId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(adminId) {
        return request.auth.uid == adminId;
      }

      allow get: if isSignedIn() && isOwner(adminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(adminId);
      allow update: if isSignedIn() && isOwner(adminId);
      allow delete: if isSignedIn() && isOwner(adminId);
    }

    /**
     * @description Enforces owner-only access for barber shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) User with UID 'user_abc' can create a barber shop with ownerId 'user_abc'.
     * @allow (get) User with UID 'user_abc' can read a barber shop with ownerId 'user_abc'.
     * @allow (update) User with UID 'user_abc' can update a barber shop with ownerId 'user_abc'.
     * @allow (delete) User with UID 'user_abc' can delete a barber shop with ownerId 'user_abc'.
     * @deny (create) User with UID 'user_xyz' cannot create a barber shop with ownerId 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Enforces owner-only access for product data within a barber shop.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) User with UID 'user_abc' can create a product in barber shop 'shop_123' if they own the shop.
     * @allow (get) Any user can read product data.
     * @allow (update) User with UID 'user_abc' can update a product in barber shop 'shop_123' if they own the shop.
     * @allow (delete) User with UID 'user_abc' can delete a product in barber shop 'shop_123' if they own the shop.
     * @deny (create) User with UID 'user_xyz' cannot create a product in barber shop 'shop_123' if they do not own the shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Enforces owner-only access for customer data within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) User with UID 'user_abc' can create a customer in barber shop 'shop_123' if they own the shop.
     * @allow (get) User with UID 'user_abc' can read a customer in barber shop 'shop_123' if they own the shop.
     * @allow (update) User with UID 'user_abc' can update a customer in barber shop 'shop_123' if they own the shop.
     * @allow (delete) User with UID 'user_abc' can delete a customer in barber shop 'shop_123' if they own the shop.
     * @deny (create) User with UID 'user_xyz' cannot create a customer in barber shop 'shop_123' if they do not own the shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Enforces owner-only access for barber data within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) User with UID 'user_abc' can create a barber in barber shop 'shop_123' if they own the shop.
     * @allow (get) User with UID 'user_abc' can read a barber in barber shop 'shop_123' if they own the shop.
     * @allow (update) User with UID 'user_abc' can update a barber in barber shop 'shop_123' if they own the shop.
     * @allow (delete) User with UID 'user_abc' can delete a barber in barber shop 'shop_123' if they own the shop.
     * @deny (create) User with UID 'user_xyz' cannot create a barber in barber shop 'shop_123' if they do not own the shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Enforces owner-only access for appointment data within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) User with UID 'user_abc' can create an appointment in barber shop 'shop_123' if they own the shop.
     * @allow (get) User with UID 'user_abc' can read an appointment in barber shop 'shop_123' if they own the shop.
     * @allow (update) User with UID 'user_abc' can update an appointment in barber shop 'shop_123' if they own the shop.
     * @allow (delete) User with UID 'user_abc' can delete an appointment in barber shop 'shop_123' if they own the shop.
     * @deny (create) User with UID 'user_xyz' cannot create an appointment in barber shop 'shop_123' if they do not own the shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Enforces owner-only access for service data within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) User with UID 'user_abc' can create a service in barber shop 'shop_123' if they own the shop.
     * @allow (get) User with UID 'user_abc' can read a service in barber shop 'shop_123' if they own the shop.
     * @allow (update) User with UID 'user_abc' can update a service in barber shop 'shop_123' if they own the shop.
     * @allow (delete) User with UID 'user_abc' can delete a service in barber shop 'shop_123' if they own the shop.
     * @deny (create) User with UID 'user_xyz' cannot create a service in barber shop 'shop_123' if they do not own the shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Enforces owner-only access for supplier data within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) User with UID 'user_abc' can create a supplier in barber shop 'shop_123' if they own the shop.
     * @allow (get) User with UID 'user_abc' can read a supplier in barber shop 'shop_123' if they own the shop.
     * @allow (update) User with UID 'user_abc' can update a supplier in barber shop 'shop_123' if they own the shop.
     * @allow (delete) User with UID 'user_abc' can delete a supplier in barber shop 'shop_123' if they own the shop.
     * @deny (create) User with UID 'user_xyz' cannot create a supplier in barber shop 'shop_123' if they do not own the shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Enforces owner-only access for financial record data within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) User with UID 'user_abc' can create a financial record in barber shop 'shop_123' if they own the shop.
     * @allow (get) User with UID 'user_abc' can read a financial record in barber shop 'shop_123' if they own the shop.
     * @allow (update) User with UID 'user_abc' can update a financial record in barber shop 'shop_123' if they own the shop.
     * @allow (delete) User with UID 'user_abc' can delete a financial record in barber shop 'shop_123' if they own the shop.
     * @deny (create) User with UID 'user_xyz' cannot create a financial record in barber shop 'shop_123' if they do not own the shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }
       /**
        * @description Controls access to support tickets.
        * @path /tickets/{ticketId}
        * @allow (get) Any authenticated user can read a ticket.
        * @allow (list) Any authenticated user can list tickets.
        * @allow (create) Any authenticated user can create a ticket.
        * @allow (update) Any authenticated user can update a ticket.
        * @allow (delete) Any authenticated user can delete a ticket.
        * @principle Allows any authenticated user to perform any operation on tickets.
        */
        match /tickets/{ticketId} {
           function isSignedIn() {
             return request.auth != null;
           }

           allow get: if isSignedIn();
           allow list: if isSignedIn();
           allow create: if isSignedIn();
           allow update: if isSignedIn();
           allow delete: if isSignedIn();
       }
         /**
        * @description Controls access to Documents.
        * @path /documents/{documentId}
        * @allow (get) Any authenticated user can read a document.
        * @allow (list) Any authenticated user can list documents.
        * @allow (create) Any authenticated user can create a document.
        * @allow (update) Any authenticated user can update a document.
        * @allow (delete) Any authenticated user can delete a document.
        * @principle Allows any authenticated user to perform any operation on documents.
        */
       match /documents/{documentId} {
        function isSignedIn() {
          return request.auth != null;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
    }
  }
}
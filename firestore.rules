/**
 * @fileoverview Firestore Security Rules for the Barber Shop SaaS application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and barber shops.
 * Subcollections under barber shops are accessible only to the barber shop owner.
 * Global read access is granted for barberShops collection to allow listing of shops by all users.
 *
 * Data Structure:
 * - /users/{userId}: User profile information.
 * - /admins/{adminId}: List of admin user IDs.
 * - /barberShops/{barberShopId}: Barber shop information, owned by a user.
 * - /barberShops/{barberShopId}/products/{productId}: Products for a specific barber shop.
 * - /barberShops/{barberShopId}/customers/{customerId}: Customers of a specific barber shop.
 * - /barberShops/{barberShopId}/barbers/{barberId}: Barbers working at a specific barber shop.
 * - /barberShops/{barberShopId}/appointments/{appointmentId}: Appointments for a specific barber shop.
 * - /barberShops/{barberShopId}/services/{serviceId}: Services offered by a specific barber shop.
 * - /barberShops/{barberShopId}/suppliers/{supplierId}: Suppliers of a specific barber shop.
 * - /barberShops/{barberShopId}/financialRecords/{financialRecordId}: Financial records for a specific barber shop.
 * - /tickets/{ticketId}: Support tickets from all users/shops.
 * - /documents/{documentId}: Platform-wide legal documents.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data.
 * - Only admins can read/write admin documents.
 * - Barber shop owners have full control over their shop's data and its subcollections.
 * - Global read access is granted for barberShops collection.
 * - Prevents listing of all users.
 *
 * Denormalization for Authorization:
 * - BarberShop subcollections denormalize `barberShopId` in the path to simplify authorization rules and enable secure querying.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own user profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile.
     *   request.auth.uid == 'user123' && request.resource.data.id == 'user123'
     * @allow (get) User with UID 'user123' can read their profile.
     *   request.auth.uid == 'user123'
     * @allow (update) User with UID 'user123' can update their profile.
     *   request.auth.uid == 'user123' && resource.data.id == 'user123'
     * @allow (delete) User with UID 'user123' can delete their profile.
     *   request.auth.uid == 'user123'
     * @deny (create) User with UID 'user123' cannot create a profile with ID 'user456'.
     *   request.auth.uid == 'user123' && request.resource.data.id == 'user456'
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Do not allow listing all users
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows admins to read and write admin data.
     * @path /admins/{adminId}
     * @allow (create) Admin with UID 'admin123' can create an admin record.
     *   request.auth.uid == 'admin123'
     * @allow (get) Admin with UID 'admin123' can read their admin record.
     *   request.auth.uid == 'admin123'
     * @allow (update) Admin with UID 'admin123' can update their admin record.
     *   request.auth.uid == 'admin123'
     * @allow (delete) Admin with UID 'admin123' can delete their admin record.
     *   request.auth.uid == 'admin123'
     * @deny (create) Non-admin user cannot create an admin record.
     *   request.auth.uid != 'admin123'
     * @principle Restricts admin data access to authorized admins only.
     */
    match /admins/{adminId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // TODO: Implement a more robust admin role check (e.g., via a custom claim)
      // For now, anyone can create an admin record if they know the path.
      allow get: if isSignedIn();
      allow list: if false; // Do not allow listing all admins
      allow create: if false; // TODO: Add admin role validation
      allow update: if false; // TODO: Add admin role validation
      allow delete: if false; // TODO: Add admin role validation
    }

    /**
     * @description Allows anyone to read barber shop data, but only the owner can modify it.
     * @path /barberShops/{barberShopId}
     * @allow (get) Any user can read barber shop data.
     *   true
     * @allow (list) Any user can list barber shops.
     *   true
     * @allow (create) User with UID 'user123' can create a barber shop if they are the owner.
     *   request.auth.uid == 'user123' && request.resource.data.ownerId == 'user123'
     * @allow (update) User with UID 'user123' can update a barber shop they own.
     *   request.auth.uid == 'user123' && resource.data.ownerId == 'user123'
     * @allow (delete) User with UID 'user123' can delete a barber shop they own.
     *   request.auth.uid == 'user123' && resource.data.ownerId == 'user123'
     * @deny (create) User with UID 'user123' cannot create a barber shop with ownerId 'user456'.
     *   request.auth.uid == 'user123' && request.resource.data.ownerId == 'user456'
     * @principle Allows public reads with owner-only writes, enforcing ownership for modifications.
     */
    match /barberShops/{barberShopId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);

      /**
       * @description Allows the barber shop owner to manage products.
       * @path /barberShops/{barberShopId}/products/{productId}
       * @allow (create) Owner of barber shop 'shop123' can create a product.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (get) Owner of barber shop 'shop123' can get a product.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (update) Owner of barber shop 'shop123' can update a product.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (delete) Owner of barber shop 'shop123' can delete a product.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @deny (create) Non-owner cannot create a product.
       *   request.auth.uid != 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @principle Restricts product management to the barber shop owner.
       */
      match /products/{productId} {
        function isShopOwner(barberShopId) {
          return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }
        
        function isExistingShopOwner(barberShopId) {
            return isShopOwner(barberShopId) && resource != null;
        }
          
        allow get: if isShopOwner(barberShopId);
        allow list: if isShopOwner(barberShopId);
        allow create: if isShopOwner(barberShopId);
        allow update: if isExistingShopOwner(barberShopId);
        allow delete: if isExistingShopOwner(barberShopId);
      }

      /**
       * @description Allows the barber shop owner to manage customers.
       * @path /barberShops/{barberShopId}/customers/{customerId}
       * @allow (create) Owner of barber shop 'shop123' can create a customer.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (get) Owner of barber shop 'shop123' can get a customer.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (update) Owner of barber shop 'shop123' can update a customer.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (delete) Owner of barber shop 'shop123' can delete a customer.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @deny (create) Non-owner cannot create a customer.
       *   request.auth.uid != 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @principle Restricts customer management to the barber shop owner.
       */
      match /customers/{customerId} {
        function isShopOwner(barberShopId) {
          return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }
          
        function isExistingShopOwner(barberShopId) {
            return isShopOwner(barberShopId) && resource != null;
        }

        allow get: if isShopOwner(barberShopId);
        allow list: if isShopOwner(barberShopId);
        allow create: if isShopOwner(barberShopId);
        allow update: if isExistingShopOwner(barberShopId);
        allow delete: if isExistingShopOwner(barberShopId);
      }

      /**
       * @description Allows the barber shop owner to manage barbers.
       * @path /barberShops/{barberShopId}/barbers/{barberId}
       * @allow (create) Owner of barber shop 'shop123' can create a barber.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (get) Owner of barber shop 'shop123' can get a barber.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (update) Owner of barber shop 'shop123' can update a barber.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (delete) Owner of barber shop 'shop123' can delete a barber.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @deny (create) Non-owner cannot create a barber.
       *   request.auth.uid != 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @principle Restricts barber management to the barber shop owner.
       */
      match /barbers/{barberId} {
        function isShopOwner(barberShopId) {
          return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }
          
        function isExistingShopOwner(barberShopId) {
            return isShopOwner(barberShopId) && resource != null;
        }

        allow get: if isShopOwner(barberShopId);
        allow list: if isShopOwner(barberShopId);
        allow create: if isShopOwner(barberShopId);
        allow update: if isExistingShopOwner(barberShopId);
        allow delete: if isExistingShopOwner(barberShopId);
      }

      /**
       * @description Allows the barber shop owner to manage appointments.
       * @path /barberShops/{barberShopId}/appointments/{appointmentId}
       * @allow (create) Owner of barber shop 'shop123' can create an appointment.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (get) Owner of barber shop 'shop123' can get an appointment.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (update) Owner of barber shop 'shop123' can update an appointment.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (delete) Owner of barber shop 'shop123' can delete an appointment.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @deny (create) Non-owner cannot create an appointment.
       *   request.auth.uid != 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @principle Restricts appointment management to the barber shop owner.
       */
      match /appointments/{appointmentId} {
        function isShopOwner(barberShopId) {
          return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }
        
        function isExistingShopOwner(barberShopId) {
            return isShopOwner(barberShopId) && resource != null;
        }

        allow get: if isShopOwner(barberShopId);
        allow list: if isShopOwner(barberShopId);
        allow create: if isShopOwner(barberShopId);
        allow update: if isExistingShopOwner(barberShopId);
        allow delete: if isExistingShopOwner(barberShopId);
      }

      /**
       * @description Allows the barber shop owner to manage services.
       * @path /barberShops/{barberShopId}/services/{serviceId}
       * @allow (create) Owner of barber shop 'shop123' can create a service.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (get) Owner of barber shop 'shop123' can get a service.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (update) Owner of barber shop 'shop123' can update a service.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (delete) Owner of barber shop 'shop123' can delete a service.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @deny (create) Non-owner cannot create a service.
       *   request.auth.uid != 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @principle Restricts service management to the barber shop owner.
       */
      match /services/{serviceId} {
        function isShopOwner(barberShopId) {
          return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }
          
        function isExistingShopOwner(barberShopId) {
            return isShopOwner(barberShopId) && resource != null;
        }

        allow get: if isShopOwner(barberShopId);
        allow list: if isShopOwner(barberShopId);
        allow create: if isShopOwner(barberShopId);
        allow update: if isExistingShopOwner(barberShopId);
        allow delete: if isExistingShopOwner(barberShopId);
      }

      /**
       * @description Allows the barber shop owner to manage suppliers.
       * @path /barberShops/{barberShopId}/suppliers/{supplierId}
       * @allow (create) Owner of barber shop 'shop123' can create a supplier.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (get) Owner of barber shop 'shop123' can get a supplier.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (update) Owner of barber shop 'shop123' can update a supplier.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (delete) Owner of barber shop 'shop123' can delete a supplier.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @deny (create) Non-owner cannot create a supplier.
       *   request.auth.uid != 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @principle Restricts supplier management to the barber shop owner.
       */
      match /suppliers/{supplierId} {
        function isShopOwner(barberShopId) {
          return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }
          
        function isExistingShopOwner(barberShopId) {
            return isShopOwner(barberShopId) && resource != null;
        }

        allow get: if isShopOwner(barberShopId);
        allow list: if isShopOwner(barberShopId);
        allow create: if isShopOwner(barberShopId);
        allow update: if isExistingShopOwner(barberShopId);
        allow delete: if isExistingShopOwner(barberShopId);
      }

      /**
       * @description Allows the barber shop owner to manage financial records.
       * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
       * @allow (create) Owner of barber shop 'shop123' can create a financial record.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (get) Owner of barber shop 'shop123' can get a financial record.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (update) Owner of barber shop 'shop123' can update a financial record.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @allow (delete) Owner of barber shop 'shop123' can delete a financial record.
       *   request.auth.uid == 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @deny (create) Non-owner cannot create a financial record.
       *   request.auth.uid != 'user123' && get(/databases/$(database)/documents/barberShops/shop123).data.ownerId == 'user123'
       * @principle Restricts financial record management to the barber shop owner.
       */
      match /financialRecords/{financialRecordId} {
        function isShopOwner(barberShopId) {
          return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        function isExistingShopOwner(barberShopId) {
            return isShopOwner(barberShopId) && resource != null;
        }
        
        allow get: if isShopOwner(barberShopId);
        allow list: if isShopOwner(barberShopId);
        allow create: if isShopOwner(barberShopId);
        allow update: if isExistingShopOwner(barberShopId);
        allow delete: if isExistingShopOwner(barberShopId);
      }
    }

    /**
     * @description Allows any authenticated user to read tickets, but restricts writes.
     * @path /tickets/{ticketId}
     * @allow (get) Any authenticated user can read a ticket.
     *   request.auth.uid != null
     * @allow (list) Any authenticated user can list tickets.
     *   request.auth.uid != null
     * @allow (create) Not allowed in this prototype.
     *   false
     * @allow (update) Not allowed in this prototype.
     *   false
     * @allow (delete) Not allowed in this prototype.
     *   false
     * @principle Restricts ticket writes for prototyping purposes.
     */
    match /tickets/{ticketId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Allows public read access to documents, but restricts writes.
     * @path /documents/{documentId}
     * @allow (get) Any user can read a document.
     *   true
     * @allow (list) Any user can list documents.
     *   true
     * @allow (create) Not allowed in this prototype.
     *   false
     * @allow (update) Not allowed in this prototype.
     *   false
     * @allow (delete) Not allowed in this prototype.
     *   false
     * @principle Grants public read access with restricted writes.
     */
    match /documents/{documentId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
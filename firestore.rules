rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is an admin.
     * @param {string} userId - The user ID to check against the admins collection.
     * @returns {bool} - True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * @description Checks if the requesting user is the owner of the resource, based on the provided userId.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @returns {bool} - True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the owner of the resource and it exists.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @returns {bool} - True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if a user is signed in.
     * @returns {bool} - True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Grants full CRUD access to admins.
     * @returns {bool} - True if the user is an admin, allowing the operation.
     */
    function allowAllIfAdmin() {
        return isAdmin();
    }


    /**
     * @description Defines security rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - An authenticated user can create their own profile if the userId matches their UID.
     * @allow (get, list) - An admin can read any user profile
     * @allow (update, delete) - An admin can update/delete any user profile.
     * @deny (create) - A user cannot create a profile with a userId that does not match their UID.
     * @principle Enforces path-based ownership and admin override.
     */
    match /users/{userId} {
      allow get, list: if allowAllIfAdmin();
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for admin profiles.
     * @path /admins/{adminId}
     * @allow (create) - An admin document can be created by another admin.
     * @allow (get, list) - Admins can view the list of admins.
     * @allow (update, delete) - Only admins can modify the list of admins.
     * @deny (create) - Non-admins cannot create admin profiles.
     * @principle Enforces admin-only access to the admin list.
     */
    match /admins/{adminId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for barber shops.
     * @path /barberShops/{barberShopId}
     * @allow (create) - Admins can create barber shops.
     * @allow (get, list) - Admins can read any barber shop's data.
     * @allow (update, delete) - Admins can update/delete any barber shop.
     * @principle Enforces admin-only access to barber shops.
     */
    match /barberShops/{barberShopId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for products within a barber shop.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) - Admins can create products for any barber shop.
     * @allow (get, list) - Admins can read any product from any barber shop.
     * @allow (update, delete) - Admins can update/delete any product from any barber shop.
     * @principle Enforces admin-only access to barber shop products.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for customers within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) - Admins can create customers for any barber shop.
     * @allow (get, list) - Admins can read any customer from any barber shop.
     * @allow (update, delete) - Admins can update/delete any customer from any barber shop.
     * @principle Enforces admin-only access to barber shop customers.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for barbers within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) - Admins can create barbers for any barber shop.
     * @allow (get, list) - Admins can read any barber from any barber shop.
     * @allow (update, delete) - Admins can update/delete any barber from any barber shop.
     * @principle Enforces admin-only access to barber shop barbers.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for appointments within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) - Admins can create appointments for any barber shop.
     * @allow (get, list) - Admins can read any appointment from any barber shop.
     * @allow (update, delete) - Admins can update/delete any appointment from any barber shop.
     * @principle Enforces admin-only access to barber shop appointments.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for services within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) - Admins can create services for any barber shop.
     * @allow (get, list) - Admins can read any service from any barber shop.
     * @allow (update, delete) - Admins can update/delete any service from any barber shop.
     * @principle Enforces admin-only access to barber shop services.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for suppliers within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) - Admins can create suppliers for any barber shop.
     * @allow (get, list) - Admins can read any supplier from any barber shop.
     * @allow (update, delete) - Admins can update/delete any supplier from any barber shop.
     * @principle Enforces admin-only access to barber shop suppliers.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for financial records within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) - Admins can create financial records for any barber shop.
     * @allow (get, list) - Admins can read any financial record from any barber shop.
     * @allow (update, delete) - Admins can update/delete any financial record from any barber shop.
     * @principle Enforces admin-only access to barber shop financial records.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for tickets.
     * @path /tickets/{ticketId}
     * @allow (create) - Admins can create a ticket
     * @allow (get, list) - Admins can view all tickets
     * @allow (update, delete) - Admins can modify any ticket.
     * @principle Enforces Admin-only access to Tickets.
     */
    match /tickets/{ticketId} {
       allow get, list, create, update, delete: if allowAllIfAdmin();
    }

    /**
     * @description Defines security rules for documents.
     * @path /documents/{documentId}
     * @allow (create) - Admins can create a document
     * @allow (get, list) - Admins can view all documents
     * @allow (update, delete) - Admins can modify any document.
     * @principle Enforces Admin-only access to Documents.
     */
    match /documents/{documentId} {
       allow get, list, create, update, delete: if allowAllIfAdmin();
    }
  }
}
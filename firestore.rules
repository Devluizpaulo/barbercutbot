/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and a shop-ownership model for barber shop data,
 *              with additional restrictions to prevent unauthorized data access. Data is organized hierarchically under users and barberShops collections.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with access restricted to the user themselves.
 * - /admins/{adminId}: Stores admin UIDs, with access restricted to existing admins.
 * - /barberShops/{barberShopId}: Stores barber shop data, with access restricted to the shop owner.
 * - /barberShops/{barberShopId}/[...]: Subcollections nested under barberShops, accessible to shop owners.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data. Listing users is disallowed.
 * - Barber shop data is primarily accessible to the shop owner, based on the `ownerId` field.
 * - Subcollections under barber shops inherit ownership from the parent shop.
 * - Read access to the /users collection is explicitly denied to prevent information disclosure.
 *
 * Denormalization for Authorization:
 * - Subcollections under `/barberShops/{barberShopId}` implicitly denormalize the `barberShopId` in the path,
 *   enabling efficient query-based authorization without additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and it exists.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces document ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) User 'iCgS9qzHn5RtjpmhWXgkea3r8lw1' can create their own profile document.
     * @allow (get) User 'iCgS9qzHn5RtjpmhWXgkea3r8lw1' can read their own profile document.
     * @allow (update) User 'iCgS9qzHn5RtjpmhWXgkea3r8lw1' can update their own profile document.
     * @allow (delete) User 'iCgS9qzHn5RtjpmhWXgkea3r8lw1' can delete their own profile document.
     * @deny (create) User 'someoneElse' cannot create a profile document for user 'iCgS9qzHn5RtjpmhWXgkea3r8lw1'.
     * @deny (get) User 'someoneElse' cannot read the profile document for user 'iCgS9qzHn5RtjpmhWXgkea3r8lw1'.
     * @deny (update) User 'someoneElse' cannot update the profile document for user 'iCgS9qzHn5RtjpmhWXgkea3r8lw1'.
     * @deny (delete) User 'someoneElse' cannot delete the profile document for user 'iCgS9qzHn5RtjpmhWXgkea3r8lw1'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Enforces admin-only access to admin list.
      * @path /admins/{adminId}
      * @allow (create) Admin 'admin1' can create an admin document.
      * @allow (get) Admin 'admin1' can read an admin document.
      * @allow (update) Admin 'admin1' can update an admin document.
      * @allow (delete) Admin 'admin1' can delete an admin document.
      * @deny (create) User 'nonAdmin' cannot create an admin document.
      * @deny (get) User 'nonAdmin' cannot read an admin document.
      * @deny (update) User 'nonAdmin' cannot update an admin document.
      * @deny (delete) User 'nonAdmin' cannot delete an admin document.
      * @principle Enforces admin-only access based on UID.
      */
    match /admins/{adminId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Enforces shop ownership for barber shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) User 'user1' can create a barber shop if they are the owner.
     * @allow (get) User 'user1' can read a barber shop if they are the owner.
     * @allow (update) User 'user1' can update a barber shop if they are the owner.
     * @allow (delete) User 'user1' can delete a barber shop if they are the owner.
     * @deny (create) User 'user2' cannot create a barber shop owned by 'user1'.
     * @deny (get) User 'user2' cannot read a barber shop owned by 'user1'.
     * @deny (update) User 'user2' cannot update a barber shop owned by 'user1'.
     * @deny (delete) User 'user2' cannot delete a barber shop owned by 'user1'.
     * @principle Enforces shop ownership based on the `ownerId` field.
     */
    match /barberShops/{barberShopId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Enforces shop ownership for products.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) User 'user1' can create a product in their barber shop.
     * @allow (get) User 'user1' can read a product in their barber shop.
     * @allow (update) User 'user1' can update a product in their barber shop.
     * @allow (delete) User 'user1' can delete a product in their barber shop.
     * @deny (create) User 'user2' cannot create a product in 'user1's barber shop.
     * @deny (get) User 'user2' cannot read a product in 'user1's barber shop.
     * @deny (update) User 'user2' cannot update a product in 'user1's barber shop.
     * @deny (delete) User 'user2' cannot delete a product in 'user1's barber shop.
     * @principle Enforces shop ownership for products.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Enforces shop ownership for customers.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) User 'user1' can create a customer in their barber shop.
     * @allow (get) User 'user1' can read a customer in their barber shop.
     * @allow (update) User 'user1' can update a customer in their barber shop.
     * @allow (delete) User 'user1' can delete a customer in their barber shop.
     * @deny (create) User 'user2' cannot create a customer in 'user1's barber shop.
     * @deny (get) User 'user2' cannot read a customer in 'user1's barber shop.
     * @deny (update) User 'user2' cannot update a customer in 'user1's barber shop.
     * @deny (delete) User 'user2' cannot delete a customer in 'user1's barber shop.
     * @principle Enforces shop ownership for customers.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Enforces shop ownership for barbers.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) User 'user1' can create a barber in their barber shop.
     * @allow (get) User 'user1' can read a barber in their barber shop.
     * @allow (update) User 'user1' can update a barber in their barber shop.
     * @allow (delete) User 'user1' can delete a barber in their barber shop.
     * @deny (create) User 'user2' cannot create a barber in 'user1's barber shop.
     * @deny (get) User 'user2' cannot read a barber in 'user1's barber shop.
     * @deny (update) User 'user2' cannot update a barber in 'user1's barber shop.
     * @deny (delete) User 'user2' cannot delete a barber in 'user1's barber shop.
     * @principle Enforces shop ownership for barbers.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Enforces shop ownership for appointments.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) User 'user1' can create an appointment in their barber shop.
     * @allow (get) User 'user1' can read an appointment in their barber shop.
     * @allow (update) User 'user1' can update an appointment in their barber shop.
     * @allow (delete) User 'user1' can delete an appointment in their barber shop.
     * @deny (create) User 'user2' cannot create an appointment in 'user1's barber shop.
     * @deny (get) User 'user2' cannot read an appointment in 'user1's barber shop.
     * @deny (update) User 'user2' cannot update an appointment in 'user1's barber shop.
     * @deny (delete) User 'user2' cannot delete an appointment in 'user1's barber shop.
     * @principle Enforces shop ownership for appointments.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Enforces shop ownership for services.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) User 'user1' can create a service in their barber shop.
     * @allow (get) User 'user1' can read a service in their barber shop.
     * @allow (update) User 'user1' can update a service in their barber shop.
     * @allow (delete) User 'user1' can delete a service in their barber shop.
     * @deny (create) User 'user2' cannot create a service in 'user1's barber shop.
     * @deny (get) User 'user2' cannot read a service in 'user1's barber shop.
     * @deny (update) User 'user2' cannot update a service in 'user1's barber shop.
     * @deny (delete) User 'user2' cannot delete a service in 'user1's barber shop.
     * @principle Enforces shop ownership for services.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Enforces shop ownership for suppliers.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) User 'user1' can create a supplier in their barber shop.
     * @allow (get) User 'user1' can read a supplier in their barber shop.
     * @allow (update) User 'user1' can update a supplier in their barber shop.
     * @allow (delete) User 'user1' can delete a supplier in their barber shop.
     * @deny (create) User 'user2' cannot create a supplier in 'user1's barber shop.
     * @deny (get) User 'user2' cannot read a supplier in 'user1's barber shop.
     * @deny (update) User 'user2' cannot update a supplier in 'user1's barber shop.
     * @deny (delete) User 'user2' cannot delete a supplier in 'user1's barber shop.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Enforces shop ownership for financial records.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) User 'user1' can create a financial record in their barber shop.
     * @allow (get) User 'user1' can read a financial record in their barber shop.
     * @allow (update) User 'user1' can update a financial record in their barber shop.
     * @allow (delete) User 'user1' can delete a financial record in their barber shop.
     * @deny (create) User 'user2' cannot create a financial record in 'user1's barber shop.
     * @deny (get) User 'user2' cannot read a financial record in 'user1's barber shop.
     * @deny (update) User 'user2' cannot update a financial record in 'user1's barber shop.
     * @deny (delete) User 'user2' cannot delete a financial record in 'user1's barber shop.
     * @principle Enforces shop ownership for financial records.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Controls access to support tickets.
     * @path /tickets/{ticketId}
     * @allow (create) Any signed-in user can create a ticket.
     * @allow (get) Any signed-in user can read a ticket.
     * @allow (update) Any signed-in user can update a ticket.
     * @allow (delete) Any signed-in user can delete a ticket.
     * @deny (create) Anonymous user cannot create a ticket.
     *  @principle Allows any signed-in user to read, update and delete any ticket, with no ownership restrictions
     */
    match /tickets/{ticketId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to platform-wide legal documents.
     * @path /documents/{documentId}
     * @allow (get) Anyone can read platform documents.
     * @allow (list) Anyone can list platform documents.
     * @allow (create) No one can create platform documents.
     * @allow (update) No one can update platform documents.
     * @allow (delete) No one can delete platform documents.
     * @principle Allows public read access for legal documents, but restrict write access.
     */
    match /documents/{documentId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
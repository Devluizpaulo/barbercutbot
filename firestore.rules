rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own profile (UID matches userId).
     * @allow (get, list, update, delete) If the user is requesting their own profile (UID matches userId).
     * @deny (create) If the user is attempting to create a profile for another user.
     * @deny (get, list, update, delete) If the user is attempting to access another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to barber shop documents.
     * @path /barberShops/{barberShopId}
     * @allow (create) If the user is creating a barber shop and sets the ownerId to their UID.
     * @allow (get, list, update, delete) If the user is the owner of the barber shop.
     * @deny (create) If the user is not setting the ownerId to their own UID.
     * @deny (get, list, update, delete) If the user is not the owner of the barber shop.
     * @principle Enforces document ownership for barber shops.
     */
    match /barberShops/{barberShopId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }

      function isCreatingAsOwner() {
        return request.auth.uid == request.resource.data.ownerId;
      }

      allow get: if isSignedIn() && isOwner();
      allow list: if true; // Listing barber shops is public.
      allow create: if isSignedIn() && isCreatingAsOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Controls access to customer documents within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (get, list, create, update, delete) If the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) If the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for customer data.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Controls access to barber documents within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (get, list, create, update, delete) If the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) If the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for barber data.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Controls access to appointment documents within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (get, list, create, update, delete) If the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) If the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for appointment data.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Controls access to service documents within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (get, list, create, update, delete) If the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) If the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for service data.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Controls access to supplier documents within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (get, list, create, update, delete) If the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) If the user is not the owner of the barber shop.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }

    /**
     * @description Controls access to financial record documents within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (get, list, create, update, delete) If the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) If the user is not the owner of the barber shop.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
    }
  }
}
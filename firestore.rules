rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user is a platform administrator via custom claims
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Checks if the user making the request is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks if the user making the request is the owner of the parent BarberShop
    function ownsBarberShop(barberShopId) {
      return isAuthenticated() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    // Admin God Mode: Admins can read and write anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // User Profiles
    match /users/{userId} {
      // Users can read and write their own profile
      // Admins can also do this via the global rule above
      allow read, write: if isOwner(userId);
    }
    
    // Barber Shops and their subcollections
    match /barberShops/{barberShopId} {
      // Any authenticated user can create a new shop
      allow create: if isAuthenticated();
      
      // Only the owner can read, update, or delete their shop
      allow read, update, delete: if ownsBarberShop(barberShopId);

      // Rule for all subcollections within a barberShop
      match /{subcollection}/{docId} {
        // Only the owner of the parent shop can access its subcollection documents
        allow read, write: if ownsBarberShop(barberShopId);
      }
    }
    
    // Global collections accessible by admins (via global rule) or specific logic
    
    // Support Tickets
    match /tickets/{ticketId} {
      // Users can create tickets
      allow create: if isAuthenticated();
      // Users can read/update their own tickets. Owner is checked via field in document.
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Public Documents
    match /documents/{documentId} {
      // Everyone can read published documents
      allow read: if resource.data.status == 'Publicado';
      // Only admins can write
      allow write: if isAdmin();
    }
  }
}

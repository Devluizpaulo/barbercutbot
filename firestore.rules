
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function isShopOwner(shopId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/barberShops/$(shopId)) &&
        get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function getShopOwnerId(shopId) {
      return get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId;
    }

    // =============================================
    // ADMIN GOD-MODE RULE (Highest Priority)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // =============================================
    // COLLECTION RULES
    // =============================================

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
    }

    match /barberShops/{shopId} {
      // Operações na própria barbearia
      allow create: if isOwner(request.resource.data.ownerId);
      allow read, update, delete: if isShopOwner(shopId);
      
      // REGRAS ESPECÍFICAS PARA SUBCOLEÇÕES
      match /appointments/{appointmentId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /appointments {
        allow list: if isShopOwner(shopId);
      }
      
      match /clients/{clientId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /clients {
        allow list: if isShopOwner(shopId);
      }
      
      match /barbers/{barberId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /barbers {
        allow list: if isShopOwner(shopId);
      }
      
      match /services/{serviceId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /services {
        allow list: if isShopOwner(shopId);
      }

      match /products/{productId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /products {
        allow list: if isShopOwner(shopId);
      }
      
      match /financialRecords/{recordId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /financialRecords {
        allow list: if isShopOwner(shopId);
      }
      
      match /suppliers/{supplierId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /suppliers {
        allow list: if isShopOwner(shopId);
      }
      
      match /team/{memberId} {
        allow read, write: if isShopOwner(shopId);
      }
      match /team {
        allow list: if isShopOwner(shopId);
      }
    }
    
    // Regra para listar barbearias
    match /barberShops {
      allow list: if isSignedIn() && request.query.where[0] == 'ownerId' && request.query.where[2] == request.auth.uid;
    }
    
    match /adminLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /tickets/{ticketId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId) || isAdmin();
    }
  }
}

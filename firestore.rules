/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a multi-tenant security model for a barber shop SaaS application.
 * All data is scoped to a specific barber shop, and access is generally restricted to the owner of that shop.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user themselves.
 * - /barberShops/{barberShopId}: Barber shop data, accessible only by the shop owner.
 * - /barberShops/{barberShopId}/[...]: Subcollections for products, customers, barbers, appointments, services, suppliers, and financial records, accessible only by the shop owner.
 * - /tickets/{ticketId}: Support tickets, write-access only for admins.
 * - /documents/{documentId}: Platform-wide documents, write-access only for admins.
 *
 * Key Security Decisions:
 * - Strict user-ownership model for most data.
 * - No user listing is allowed for privacy.
 * - Denormalization of barberShopId in subcollections enables efficient and secure list operations.
 * - Admin role required for creating/updating/deleting support tickets and platform documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their profile with id: 'user_abc'.
     * @allow (get) User with UID 'user_abc' can get their profile.
     * @allow (update) User with UID 'user_abc' can update their profile.
     * @allow (delete) User with UID 'user_abc' can delete their profile.
     * @deny (create) User with UID 'user_xyz' cannot create a profile with id: 'user_abc'.
     * @deny (get) User with UID 'user_xyz' cannot get user 'user_abc' profile.
     * @deny (update) User with UID 'user_xyz' cannot update user 'user_abc' profile.
     * @deny (delete) User with UID 'user_xyz' cannot delete user 'user_abc' profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows the owner to manage their barber shop's data.
     * @path /barberShops/{barberShopId}
     * @allow (create) User with UID 'user_abc' can create a barber shop with ownerId: 'user_abc'.
     * @allow (get) User with UID 'user_abc' can get a barber shop with ownerId: 'user_abc'.
     * @allow (update) User with UID 'user_abc' can update a barber shop with ownerId: 'user_abc'.
     * @allow (delete) User with UID 'user_abc' can delete a barber shop with ownerId: 'user_abc'.
     * @deny (create) User with UID 'user_xyz' cannot create a barber shop with ownerId: 'user_abc'.
     * @deny (get) User with UID 'user_xyz' cannot get barber shop with ownerId 'user_abc'.
     * @deny (update) User with UID 'user_xyz' cannot update barber shop with ownerId: 'user_abc'.
     * @deny (delete) User with UID 'user_xyz' cannot delete barber shop with ownerId: 'user_abc'.
     * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
     */
    match /barberShops/{barberShopId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }

      function isCreatingOwner() {
          return request.auth.uid == request.resource.data.ownerId;
      }

      allow get: if isSignedIn() && isOwner();
      allow list: if false;
      allow create: if isSignedIn() && isCreatingOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();

       /**
         * @description Allows the owner to manage their barber shop's products.
         * @path /barberShops/{barberShopId}/products/{productId}
         * @allow (create) User with UID 'user_abc' can create a product for barber shop with ownerId: 'user_abc'.
         * @allow (get) User with UID 'user_abc' can get a product for barber shop with ownerId: 'user_abc'.
         * @allow (update) User with UID 'user_abc' can update a product for barber shop with ownerId: 'user_abc'.
         * @allow (delete) User with UID 'user_abc' can delete a product for barber shop with ownerId: 'user_abc'.
         * @deny (create) User with UID 'user_xyz' cannot create a product for barber shop with ownerId: 'user_abc'.
         * @deny (get) User with UID 'user_xyz' cannot get product for barber shop with ownerId 'user_abc'.
         * @deny (update) User with UID 'user_xyz' cannot update product for barber shop with ownerId: 'user_abc'.
         * @deny (delete) User with UID 'user_xyz' cannot delete product for barber shop with ownerId: 'user_abc'.
         * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
         */
      match /products/{productId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow list: if false;
        allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner to manage their barber shop's customers.
       * @path /barberShops/{barberShopId}/customers/{customerId}
       * @allow (create) User with UID 'user_abc' can create a customer for barber shop with ownerId: 'user_abc'.
       * @allow (get) User with UID 'user_abc' can get a customer for barber shop with ownerId: 'user_abc'.
       * @allow (update) User with UID 'user_abc' can update a customer for barber shop with ownerId: 'user_abc'.
       * @allow (delete) User with UID 'user_abc' can delete a customer for barber shop with ownerId: 'user_abc'.
       * @deny (create) User with UID 'user_xyz' cannot create a customer for barber shop with ownerId: 'user_abc'.
       * @deny (get) User with UID 'user_xyz' cannot get customer for barber shop with ownerId 'user_abc'.
       * @deny (update) User with UID 'user_xyz' cannot update customer for barber shop with ownerId: 'user_abc'.
       * @deny (delete) User with UID 'user_xyz' cannot delete customer for barber shop with ownerId: 'user_abc'.
       * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
       */
      match /customers/{customerId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow list: if false;
        allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner to manage their barber shop's barbers.
       * @path /barberShops/{barberShopId}/barbers/{barberId}
       * @allow (create) User with UID 'user_abc' can create a barber for barber shop with ownerId: 'user_abc'.
       * @allow (get) User with UID 'user_abc' can get a barber for barber shop with ownerId: 'user_abc'.
       * @allow (update) User with UID 'user_abc' can update a barber for barber shop with ownerId: 'user_abc'.
       * @allow (delete) User with UID 'user_abc' can delete a barber for barber shop with ownerId: 'user_abc'.
       * @deny (create) User with UID 'user_xyz' cannot create a barber for barber shop with ownerId: 'user_abc'.
       * @deny (get) User with UID 'user_xyz' cannot get barber for barber shop with ownerId 'user_abc'.
       * @deny (update) User with UID 'user_xyz' cannot update barber for barber shop with ownerId: 'user_abc'.
       * @deny (delete) User with UID 'user_xyz' cannot delete barber for barber shop with ownerId: 'user_abc'.
       * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
       */
      match /barbers/{barberId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow list: if false;
        allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner to manage their barber shop's appointments.
       * @path /barberShops/{barberShopId}/appointments/{appointmentId}
       * @allow (create) User with UID 'user_abc' can create an appointment for barber shop with ownerId: 'user_abc'.
       * @allow (get) User with UID 'user_abc' can get an appointment for barber shop with ownerId: 'user_abc'.
       * @allow (update) User with UID 'user_abc' can update an appointment for barber shop with ownerId: 'user_abc'.
       * @allow (delete) User with UID 'user_abc' can delete an appointment for barber shop with ownerId: 'user_abc'.
       * @deny (create) User with UID 'user_xyz' cannot create an appointment for barber shop with ownerId: 'user_abc'.
       * @deny (get) User with UID 'user_xyz' cannot get appointment for barber shop with ownerId 'user_abc'.
       * @deny (update) User with UID 'user_xyz' cannot update appointment for barber shop with ownerId: 'user_abc'.
       * @deny (delete) User with UID 'user_xyz' cannot delete appointment for barber shop with ownerId: 'user_abc'.
       * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
       */
      match /appointments/{appointmentId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow list: if false;
        allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner to manage their barber shop's services.
       * @path /barberShops/{barberShopId}/services/{serviceId}
       * @allow (create) User with UID 'user_abc' can create a service for barber shop with ownerId: 'user_abc'.
       * @allow (get) User with UID 'user_abc' can get a service for barber shop with ownerId: 'user_abc'.
       * @allow (update) User with UID 'user_abc' can update a service for barber shop with ownerId: 'user_abc'.
       * @allow (delete) User with UID 'user_abc' can delete a service for barber shop with ownerId: 'user_abc'.
       * @deny (create) User with UID 'user_xyz' cannot create a service for barber shop with ownerId: 'user_abc'.
       * @deny (get) User with UID 'user_xyz' cannot get service for barber shop with ownerId 'user_abc'.
       * @deny (update) User with UID 'user_xyz' cannot update service for barber shop with ownerId: 'user_abc'.
       * @deny (delete) User with UID 'user_xyz' cannot delete service for barber shop with ownerId: 'user_abc'.
       * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
       */
      match /services/{serviceId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow list: if false;
        allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
      }

       /**
         * @description Allows the owner to manage their barber shop's suppliers.
         * @path /barberShops/{barberShopId}/suppliers/{supplierId}
         * @allow (create) User with UID 'user_abc' can create a supplier for barber shop with ownerId: 'user_abc'.
         * @allow (get) User with UID 'user_abc' can get a supplier for barber shop with ownerId: 'user_abc'.
         * @allow (update) User with UID 'user_abc' can update a supplier for barber shop with ownerId: 'user_abc'.
         * @allow (delete) User with UID 'user_abc' can delete a supplier for barber shop with ownerId: 'user_abc'.
         * @deny (create) User with UID 'user_xyz' cannot create a supplier for barber shop with ownerId: 'user_abc'.
         * @deny (get) User with UID 'user_xyz' cannot get supplier for barber shop with ownerId 'user_abc'.
         * @deny (update) User with UID 'user_xyz' cannot update supplier for barber shop with ownerId: 'user_abc'.
         * @deny (delete) User with UID 'user_xyz' cannot delete supplier for barber shop with ownerId: 'user_abc'.
         * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
         */
      match /suppliers/{supplierId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow list: if false;
        allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner to manage their barber shop's financial records.
       * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
       * @allow (create) User with UID 'user_abc' can create a financial record for barber shop with ownerId: 'user_abc'.
       * @allow (get) User with UID 'user_abc' can get a financial record for barber shop with ownerId: 'user_abc'.
       * @allow (update) User with UID 'user_abc' can update a financial record for barber shop with ownerId: 'user_abc'.
       * @allow (delete) User with UID 'user_abc' can delete a financial record for barber shop with ownerId: 'user_abc'.
       * @deny (create) User with UID 'user_xyz' cannot create a financial record for barber shop with ownerId: 'user_abc'.
       * @deny (get) User with UID 'user_xyz' cannot get financial record for barber shop with ownerId 'user_abc'.
       * @deny (update) User with UID 'user_xyz' cannot update financial record for barber shop with ownerId: 'user_abc'.
       * @deny (delete) User with UID 'user_xyz' cannot delete financial record for barber shop with ownerId: 'user_abc'.
       * @principle Enforces document ownership for writes, restricts access to a barber shop owner.
       */
      match /financialRecords/{financialRecordId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isBarberShopOwner(barberShopId) {
          return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow list: if false;
        allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow update: if isSignedIn() && isBarberShopOwner(barberShopId);
        allow delete: if isSignedIn() && isBarberShopOwner(barberShopId);
      }
    }

     /**
      * @description Allows admins to manage support tickets.
      * @path /tickets/{ticketId}
      * @allow (get) Admins can get any ticket.
      * @allow (list) Admins can list all tickets.
      * @allow (create) Admins can create tickets.
      * @allow (update) Admins can update tickets.
      * @allow (delete) Admins can delete tickets.
      * @deny (get) Non-admins cannot get tickets.
      * @deny (list) Non-admins cannot list tickets.
      * @deny (create) Non-admins cannot create tickets.
      * @deny (update) Non-admins cannot update tickets.
      * @deny (delete) Non-admins cannot delete tickets.
      * @principle Restricts access to support tickets to admin users only.
      */
    match /tickets/{ticketId} {
       function isAdmin() {
            return request.auth.token.admin == true;
        }

        function isSignedIn() {
            return request.auth != null;
        }


        allow get: if isSignedIn() && isAdmin();
        allow list: if isSignedIn() && isAdmin();
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows admins to manage platform documents.
     * @path /documents/{documentId}
     * @allow (get) Admins can get any document.
     * @allow (list) Admins can list all documents.
     * @allow (create) Admins can create documents.
     * @allow (update) Admins can update documents.
     * @allow (delete) Admins can delete documents.
     * @deny (get) Non-admins cannot get documents.
     * @deny (list) Non-admins cannot list documents.
     * @deny (create) Non-admins cannot create documents.
     * @deny (update) Non-admins cannot update documents.
     * @deny (delete) Non-admins cannot delete documents.
     * @principle Restricts access to platform documents to admin users only.
     */
    match /documents/{documentId} {
        function isAdmin() {
            return request.auth.token.admin == true;
        }

        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if isSignedIn() && isAdmin();
        allow list: if isSignedIn() && isAdmin();
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }
  }
}
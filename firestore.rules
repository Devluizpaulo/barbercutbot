
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isShopOwner(shopId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/barberShops/$(shopId)) &&
        get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // ADMIN GOD-MODE (HIGHEST PRIORITY)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // =============================================
    // USER AND SHOP RULES
    // =============================================

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
    }

    match /barberShops/{shopId} {
      // Owner can create and manage their own shop document.
      allow create: if request.auth.uid == request.resource.data.ownerId;
      // Allow read, update, delete for the shop owner.
      allow read, update, delete: if isShopOwner(shopId);
      // For listing shops, ensure the user is the owner.
      allow list: if isSignedIn() && request.query.ownerId == request.auth.uid;
    }
    
    // =============================================
    // SUB-COLLECTION RULES (CRITICAL FOR PERFORMANCE AND SECURITY)
    // =============================================

    match /barberShops/{shopId}/{subcollection}/{docId} {
        // GET, CREATE, UPDATE, DELETE rules remain unchanged.
        // They operate on a single document, so using `get` is allowed and secure.
        allow get, write: if isShopOwner(shopId);

        // LIST (queries) must be handled differently.
        // This rule enforces that any query on a subcollection MUST include a `where`
        // clause filtering by 'barberShopId'. This is the recommended pattern.
        allow list: if isSignedIn()
                    && request.query.keys().hasAny(['barberShopId']) && request.query.barberShopId == shopId;
    }
    
    // =============================================
    // PLATFORM-WIDE COLLECTIONS
    // =============================================

    match /adminLogs/{logId} {
      allow create: if isSignedIn();
      // Admins can do anything with logs
      allow read, write: if isAdmin();
    }

    match /tickets/{ticketId} {
      // User can create their own ticket.
      allow create: if request.auth.uid == request.resource.data.userId;
      // Owner of ticket or admin can read/write.
      allow read, write: if request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId || isAdmin();
    }
  }
}

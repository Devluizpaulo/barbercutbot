/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and barber shops.
 * All data is nested under either /users/{userId} or /barberShops/{barberShopId}, ensuring clear ownership.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /admins/{adminId}: Stores admin UIDs, only accessible to admins.
 * - /barberShops/{barberShopId}: Stores barber shop data, accessible only by the shop owner.
 * - /barberShops/{barberShopId}/{collection}/{documentId}: Stores data related to a specific barber shop, accessible only by the shop owner.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Barber shops can only be created by authenticated users.
 * - Barber shop data is only accessible to the owner of the shop.
 * - Listing of users is disallowed.
 * - Listing of admins is disallowed.
 * - Documents and Tickets are publicly readable, but writes are restricted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of a document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin.
     */
     function isAdmin() {
        return exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    /**
     * @description Rule for user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' creates their profile document with id 'user123'.
     * @allow (get, update, delete) User with UID 'user123' reads, updates, or deletes their profile document with id 'user123'.
     * @deny (create) User with UID 'user123' attempts to create a profile document with id 'user456'.
     * @deny (get, update, delete) User with UID 'user123' attempts to read, update, or delete profile document with id 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

     /**
     * @description Rule for admins.
     * @path /admins/{adminId}
     * @allow (create) User with UID 'admin123' creates their admin document with id 'admin123'.
     * @allow (get, update, delete) User with UID 'admin123' reads, updates, or deletes their admin document with id 'admin123'.
     * @deny (create) User with UID 'admin123' attempts to create a admin document with id 'admin456'.
     * @deny (get, update, delete) User with UID 'admin123' attempts to read, update, or delete admin document with id 'admin456'.
     * @principle Enforces document ownership for all operations.
     */
    match /admins/{adminId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rule for barber shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) Authenticated user creates a barber shop.
     * @allow (get, update, delete) Owner of the barber shop can read, update, or delete it.
     * @deny (update, delete) Non-owner attempts to update or delete the barber shop.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Rule for products within a barber shop.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create, update, delete) Owner of the barber shop can create, update, or delete products.
     * @deny (update, delete) Non-owner attempts to update or delete products.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
      allow delete: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
    }

    /**
     * @description Rule for customers within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create, update, delete) Owner of the barber shop can create, update, or delete customers.
     * @deny (update, delete) Non-owner attempts to update or delete customers.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get: if true;
      allow list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
      allow delete: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
    }

    /**
     * @description Rule for barbers within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create, update, delete) Owner of the barber shop can create, update, or delete barbers.
     * @deny (update, delete) Non-owner attempts to update or delete barbers.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get: if true;
      allow list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
      allow delete: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
    }

    /**
     * @description Rule for appointments within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create, update, delete) Owner of the barber shop can create, update, or delete appointments.
     * @deny (update, delete) Non-owner attempts to update or delete appointments.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get: if true;
      allow list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
      allow delete: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
    }

    /**
     * @description Rule for services within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create, update, delete) Owner of the barber shop can create, update, or delete services.
     * @deny (update, delete) Non-owner attempts to update or delete services.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get: if true;
      allow list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
      allow delete: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
    }

    /**
     * @description Rule for suppliers within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create, update, delete) Owner of the barber shop can create, update, or delete suppliers.
     * @deny (update, delete) Non-owner attempts to update or delete suppliers.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get: if true;
      allow list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
      allow delete: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
    }

    /**
     * @description Rule for financial records within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create, update, delete) Owner of the barber shop can create, update, or delete financial records.
     * @deny (update, delete) Non-owner attempts to update or delete financial records.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get: if true;
      allow list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
      allow delete: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId) && resource != null;
    }

    /**
     * @description Rule for tickets.
     * @path /tickets/{ticketId}
     * @allow (get, list) Any authenticated user can read the tickets.
     * @deny (create, update, delete) Only admin can create, update, and delete the tickets.
     * @principle Allows public read access but restricts writes to admins.
     */
    match /tickets/{ticketId} {
        allow get, list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin() && resource != null;
        allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for legal documents.
     * @path /documents/{documentId}
     * @allow (get, list) Any authenticated user can read the documents.
     * @deny (create, update, delete) Only admin can create, update, and delete the documents.
     * @principle Allows public read access but restricts writes to admins.
     */
    match /documents/{documentId} {
        allow get, list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin() && resource != null;
        allow delete: if isAdmin() && resource != null;
    }
  }
}
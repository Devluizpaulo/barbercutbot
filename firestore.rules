
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@bbr.com';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isShopOwner(shopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // Admin can read and write anything
    match /{path=**} {
      allow read, write: if isAdmin();
    }
    
    // Users can read/update their own profile
    match /users/{userId} {
      allow read, update: if isOwner(userId);
    }
    
    // BarberShops can be read by anyone (for public profiles), created by any authenticated user, 
    // and updated/deleted only by the owner.
    match /barberShops/{shopId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if isShopOwner(shopId);
    }
    
    // Subcollections of BarberShops can be managed by the shop owner.
    match /barberShops/{shopId}/{subcollection}/{documentId} {
        allow read, write: if isShopOwner(shopId);
    }
    
    // Specific rules for platform-wide collections like tickets and documents
    match /tickets/{ticketId} {
        allow create: if request.auth != null;
        allow read, update: if get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid;
    }

    match /documents/{documentId} {
        allow read: if true;
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isShopOwner(shopId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/barberShops/$(shopId)) &&
        get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }
    
    // Checks if the user is the owner OR a registered team member of the shop
    function isShopMember(shopId) {
      return isShopOwner(shopId) || 
             (isSignedIn() && exists(/databases/$(database)/documents/barberShops/$(shopId)/team/$(request.auth.uid)));
    }

    // =============================================
    // ADMIN GOD-MODE RULE (Highest Priority)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // =============================================
    // USER & SHOP RULES
    // =============================================

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
    }
    
    match /barberShops/{shopId} {
      allow create: if isOwner(request.resource.data.ownerId);
      allow read, update, delete: if isShopOwner(shopId);
    }
    
    // Rule for a user to list only their own shops
    match /barberShops {
      allow list: if isSignedIn() && request.query.where[0] == 'ownerId' && request.query.where[2] == request.auth.uid;
    }

    // =============================================
    // SHOP SUB-COLLECTION RULES
    // =============================================

    match /barberShops/{shopId}/{subcollection}/{docId} {
        // READ (get, list): Allow if user is a member of the shop
        allow get: if isShopMember(shopId);
        
        // This is the CRITICAL rule for LIST operations.
        // It allows a list query ONLY IF it includes a `where('barberShopId', '==', shopId)` clause.
        // This ensures queries are scoped per shop and performant.
        allow list: if isSignedIn() && request.query.where[0] == 'barberShopId' && request.query.where[2] == shopId && isShopMember(shopId);
        
        // WRITE (create, update, delete): Allow only if the user is the shop owner.
        allow write: if isShopOwner(shopId);
    }
    
    // =============================================
    // PLATFORM-WIDE RULES
    // =============================================
    
    match /adminLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /tickets/{ticketId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId) || isAdmin();
    }
  }
}

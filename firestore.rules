/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and a shop-ownership model for barber shop data,
 *              with additional restrictions based on user roles and data relationships.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Access is restricted to the user themselves (ownership).
 * - /admins/{adminId}: Stores a list of admin user UIDs. Only admins can manage this collection.
 * - /barberShops/{barberShopId}: Stores barber shop data. Access is restricted to the shop owner.
 * - /barberShops/{barberShopId}/...: Subcollections store data related to a specific barber shop (e.g., customers, barbers, appointments).
 *   Access to these subcollections is restricted to the owner of the barber shop.
 * - /tickets/{ticketId}: Stores support tickets.
 * - /documents/{documentId}: Stores platform-wide legal documents.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data under /users/{userId}.
 * - Listing of users is forbidden to protect user privacy.
 * - All data under /barberShops/{barberShopId} is controlled by the shop's owner, enforcing tenant-level data isolation.
 * - Write access to /admins/{adminId} is denied to all, implying admin management should be done via the Firebase Console or a trusted backend.
 * - All write operations are validated to ensure data consistency and prevent unauthorized modifications.
 *
 * Denormalization for Authorization:
 * - The `barberShopId` is implicitly denormalized in the paths of subcollections under `/barberShops/{barberShopId}`. This allows for simpler and more efficient security rules, as it eliminates the need for additional `get()` calls to verify the relationship between documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' can create their own profile if request.auth.uid == userId
     * @allow (get) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' can read their profile.
     * @allow (update) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' can update their profile.
     * @allow (delete) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' can delete their profile.
     * @deny (create) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' cannot create a profile for another user (e.g., userId = 'otherUserId').
     * @deny (get) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' cannot read another user's profile (e.g., userId = 'otherUserId').
     * @deny (update) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' cannot update another user's profile (e.g., userId = 'otherUserId').
     * @deny (delete) - User with UID 'rrCNVBCNomhqZ3UmmhCpbWoFgkK2' cannot delete another user's profile (e.g., userId = 'otherUserId').
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Restricts access to the admins collection. Only admins can manage this collection.
     * @path /admins/{adminId}
     * @deny (get) - No one can get documents
     * @deny (list) - No one can list documents
     * @deny (create) - No one can create documents
     * @deny (update) - No one can update documents
     * @deny (delete) - No one can delete documents
     * @principle Restricts access to a user's own data tree.
     */
    match /admins/{adminId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows the owner of a barber shop to manage their shop's data.
     * @path /barberShops/{barberShopId}
     */
    match /barberShops/{barberShopId} {
      function isShopOwner(barberShopId) {
        return request.auth.uid == get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId;
      }

      function isCreatingShop() {
        return request.auth.uid == request.resource.data.ownerId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isCreatingShop();
      allow update: if isShopOwner(barberShopId);
      allow delete: if isShopOwner(barberShopId);

        /**
         * @description Allows the owner of a barber shop to manage products.
         * @path /barberShops/{barberShopId}/products/{productId}
         */
        match /barberShops/{barberShopId}/products/{productId} {
          allow get: if true;
          allow list: if true;
          allow create: if isShopOwner(barberShopId);
          allow update: if isShopOwner(barberShopId);
          allow delete: if isShopOwner(barberShopId);
        }

        /**
         * @description Allows the owner of a barber shop to manage customers.
         * @path /barberShops/{barberShopId}/customers/{customerId}
         */
        match /barberShops/{barberShopId}/customers/{customerId} {
          allow get: if true;
          allow list: if true;
          allow create: if isShopOwner(barberShopId);
          allow update: if isShopOwner(barberShopId);
          allow delete: if isShopOwner(barberShopId);
        }

        /**
         * @description Allows the owner of a barber shop to manage barbers.
         * @path /barberShops/{barberShopId}/barbers/{barberId}
         */
        match /barberShops/{barberShopId}/barbers/{barberId} {
          allow get: if true;
          allow list: if true;
          allow create: if isShopOwner(barberShopId);
          allow update: if isShopOwner(barberShopId);
          allow delete: if isShopOwner(barberShopId);
        }

        /**
         * @description Allows the owner of a barber shop to manage appointments.
         * @path /barberShops/{barberShopId}/appointments/{appointmentId}
         */
        match /barberShops/{barberShopId}/appointments/{appointmentId} {
          allow get: if true;
          allow list: if true;
          allow create: if isShopOwner(barberShopId);
          allow update: if isShopOwner(barberShopId);
          allow delete: if isShopOwner(barberShopId);
        }

        /**
         * @description Allows the owner of a barber shop to manage services.
         * @path /barberShops/{barberShopId}/services/{serviceId}
         */
        match /barberShops/{barberShopId}/services/{serviceId} {
          allow get: if true;
          allow list: if true;
          allow create: if isShopOwner(barberShopId);
          allow update: if isShopOwner(barberShopId);
          allow delete: if isShopOwner(barberShopId);
        }

        /**
         * @description Allows the owner of a barber shop to manage suppliers.
         * @path /barberShops/{barberShopId}/suppliers/{supplierId}
         */
        match /barberShops/{barberShopId}/suppliers/{supplierId} {
          allow get: if true;
          allow list: if true;
          allow create: if isShopOwner(barberShopId);
          allow update: if isShopOwner(barberShopId);
          allow delete: if isShopOwner(barberShopId);
        }

        /**
         * @description Allows the owner of a barber shop to manage financial records.
         * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
         */
        match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
          allow get: if true;
          allow list: if true;
          allow create: if isShopOwner(barberShopId);
          allow update: if isShopOwner(barberShopId);
          allow delete: if isShopOwner(barberShopId);
        }
    }

    /**
     * @description Allows manage support tickets.
     * @path /tickets/{ticketId}
     */
    match /tickets/{ticketId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows manage legal documents.
     * @path /documents/{documentId}
     */
    match /documents/{documentId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
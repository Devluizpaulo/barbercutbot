
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function isShopOwner(shopId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/barberShops/$(shopId)) &&
        get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // Checks if the user is the owner OR a registered team member of the shop
    function isShopMember(shopId) {
      return isShopOwner(shopId) || 
             (isSignedIn() && exists(/databases/$(database)/documents/barberShops/$(shopId)/team/$(request.auth.uid)));
    }

    // =============================================
    // ADMIN GOD-MODE RULE (Highest Priority)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // =============================================
    // COLLECTION RULES
    // =============================================

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
    }

    match /barberShops/{shopId} {
      // Shop owner can create, read, update, delete their own shop document
      allow create: if isOwner(request.resource.data.ownerId);
      allow read, update, delete: if isShopOwner(shopId);
      
      // Any team member can READ data within the shop
      match /{subcollection}/{docId=**} {
        allow read: if isShopMember(shopId);
        // Only the shop owner can WRITE data within the shop
        allow write: if isShopOwner(shopId);
      }
    }
    
    // Rule for a user to list only their own shops
    match /barberShops {
      allow list: if isSignedIn() && request.query.where[0] == 'ownerId' && request.query.where[2] == request.auth.uid;
    }
    
    match /adminLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /tickets/{ticketId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId) || isAdmin();
    }
  }
}

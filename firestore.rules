
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se o usuário é um administrador
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Usuários podem ler/escrever seus próprios perfis. Admins podem ler todos.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId;
    }
    
    // Admins podem ler/escrever todos os documentos de usuários.
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Regras para a coleção 'admins'
    match /admins/{adminId} {
      // Apenas admins podem ler a lista de admins.
      allow read: if isAdmin();
      // Ninguém pode escrever diretamente (controlado via backend/funções)
      allow write: if false; 
    }

    // Barbearias podem ser lidas por qualquer um, escritas pelo dono ou admin.
    match /barberShops/{shopId} {
      allow read: if true;
      allow write: if request.auth.uid == resource.data.ownerId || isAdmin();
    }

    // Subcoleções das barbearias (clientes, agendamentos, etc.)
    match /barberShops/{shopId}/{collection}/{docId} {
      // O dono da loja ou um admin pode ler e escrever.
      allow read, write: if get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid || isAdmin();
    }
    
    // Coleção de tickets de suporte
    match /tickets/{ticketId} {
      // O usuário que criou o ticket ou um admin pode ler.
      allow read: if resource.data.userId == request.auth.uid || isAdmin();
      // O usuário que criou ou um admin pode criar/atualizar.
      allow write: if request.resource.data.userId == request.auth.uid || isAdmin();
    }

    // Coleção de documentos legais
    match /documents/{documentId} {
      // Todos podem ler documentos.
      allow read: if true;
      // Apenas admins podem criar/atualizar/excluir.
      allow write: if isAdmin();
    }
  }
}

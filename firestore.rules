/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and barber shops.
 *   Barber shop data is segregated by shop ID, with ownership validated via the `ownerId` field.
 *   Subcollections under `/barberShops/{barberShopId}` are secured to only allow access by the barber shop owner.
 *   This design prioritizes authorization independence through path-based ownership and denormalization,
 *   avoiding the need for `get()` calls in security rules and enabling atomic operations.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Each user can only access their own profile.
 * - /barberShops/{barberShopId}: Stores barber shop data. Access controlled by shop ownership (`ownerId`).
 * - /barberShops/{barberShopId}/...: Subcollections for products, customers, barbers, appointments, services, suppliers, and financial records.
 * - /tickets/{ticketId}: Stores support tickets.
 * - /documents/{documentId}: Stores legal documents.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the user themselves.
 * - Barber shops are owned by a specific user, who has full access to the shop's data.
 * - Subcollections inherit the barber shop's ownership, ensuring only the owner can manage data within the shop.
 * - Listing users is disallowed for privacy.
 * - The `admins` collection does not exist and, therefore, no special admin privileges are configured.
 * - Public read access is not granted to any collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Secure user profiles. Only the authenticated user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User 'user_abc' can create their own profile: request.auth.uid == 'user_abc'
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete their own profile.
     * @deny (create) User 'user_xyz' cannot create a profile for 'user_abc': request.auth.uid != 'user_abc'
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete the profile of 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure barber shop data. Only the owner can read and write shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) User 'user_abc' can create a barberShop if they are the owner: request.resource.data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete their own barberShop.
     * @deny (create) User 'user_xyz' cannot create a barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete the barberShop owned by 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId} {
        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Secure product data for a specific barber shop. Only the shop owner can manage products.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) User 'user_abc' can create a product if they own the barberShop: get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete a product in their barberShop.
     * @deny (create) User 'user_xyz' cannot create a product for barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete a product in barberShop owned by 'user_abc'.
     * @principle Enforces ownership via a parent document lookup.
     */
    match /barberShops/{barberShopId}/products/{productId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Secure customer data for a specific barber shop. Only the shop owner can manage customers.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) User 'user_abc' can create a customer if they own the barberShop: get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete a customer in their barberShop.
     * @deny (create) User 'user_xyz' cannot create a customer for barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete a customer in barberShop owned by 'user_abc'.
     * @principle Enforces ownership via a parent document lookup.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Secure barber data for a specific barber shop. Only the shop owner can manage barbers.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) User 'user_abc' can create a barber if they own the barberShop: get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete a barber in their barberShop.
     * @deny (create) User 'user_xyz' cannot create a barber for barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete a barber in barberShop owned by 'user_abc'.
     * @principle Enforces ownership via a parent document lookup.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Secure appointment data for a specific barber shop. Only the shop owner can manage appointments.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) User 'user_abc' can create an appointment if they own the barberShop: get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete an appointment in their barberShop.
     * @deny (create) User 'user_xyz' cannot create an appointment for barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete an appointment in barberShop owned by 'user_abc'.
     * @principle Enforces ownership via a parent document lookup.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Secure service data for a specific barber shop. Only the shop owner can manage services.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) User 'user_abc' can create a service if they own the barberShop: get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete a service in their barberShop.
     * @deny (create) User 'user_xyz' cannot create a service for barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete a service in barberShop owned by 'user_abc'.
     * @principle Enforces ownership via a parent document lookup.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

     /**
     * @description Secure supplier data for a specific barber shop. Only the shop owner can manage suppliers.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) User 'user_abc' can create a supplier if they own the barberShop: get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete a supplier in their barberShop.
     * @deny (create) User 'user_xyz' cannot create a supplier for barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete a supplier in barberShop owned by 'user_abc'.
     * @principle Enforces ownership via a parent document lookup.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }

    /**
     * @description Secure financial record data for a specific barber shop. Only the shop owner can manage financial records.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) User 'user_abc' can create a financial record if they own the barberShop: get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid
     * @allow (get, update, delete) User 'user_abc' can get, update, and delete a financial record in their barberShop.
     * @deny (create) User 'user_xyz' cannot create a financial record for barberShop owned by 'user_abc'.
     * @deny (get, update, delete) User 'user_xyz' cannot get, update, or delete a financial record in barberShop owned by 'user_abc'.
     * @principle Enforces ownership via a parent document lookup.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
    }
    /**
     * @description Secure platform-wide support tickets.
     * @path /tickets/{ticketId}
     * @allow (get, list) Any authenticated user can read tickets.
     * @allow (create) Any authenticated user can create tickets.
     * @allow (update, delete) No one can update or delete tickets.
     * @principle Enforces public read access with restricted write access.
     */
    match /tickets/{ticketId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }

     /**
     * @description Secure platform-wide documents (e.g., terms of service).
     * @path /documents/{documentId}
     * @allow (get, list) Any user can read documents.
     * @allow (create, update, delete) No one can create, update or delete documents.
     * @principle Enforces public read-only access.
     */
     match /documents/{documentId} {
        allow get: if true;
        allow list: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check for the custom claim 'admin' on the auth token.
      // This is more secure and efficient than reading a document.
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isOwnerOfBarberShop(barberShopId) {
      return isAuthenticated() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    // This is a "catch-all" rule for administrators.
    // If the user is an admin, they can do anything.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // User can only read and write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Barber Shops can be created by any authenticated user.
    // Only the owner can read, update, or delete their own shop.
    match /barberShops/{barberShopId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isOwnerOfBarberShop(barberShopId);
      
      // Anyone who owns the parent barber shop can read/write to subcollections.
      match /{subcollection}/{docId} {
        allow read, write: if isOwnerOfBarberShop(barberShopId);
      }
    }

    // Tickets can be read by their creator or by an admin.
    // Admins can write to any ticket.
    match /tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isAdmin(); // Admin can update/close tickets
      allow create: if isAuthenticated(); // Any user can create
    }
  }
}

/**
 * @fileOverview Firestore Security Rules for the Barber Shop SaaS application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and barber shops.
 * Subcollections under barber shops are accessible only to the owner of the barber shop.
 * Platform-level support tickets and documents have specific access rules.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, owned by the user with matching UID.
 * - /admins/{adminId}: Admin user list (UIDs).
 * - /barberShops/{barberShopId}: Barber shop data, owned by the user specified in the `ownerId` field.
 * - /barberShops/{barberShopId}/...: Subcollections containing data related to a specific barber shop. Access is restricted to the barber shop owner.
 * - /tickets/{ticketId}: Support tickets.
 * - /documents/{documentId}: Legal documents.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user profiles.
 * - Barber shop creation, modification, and deletion are restricted to the owner of the shop.
 * - Subcollections of a barber shop (customers, barbers, appointments, services, financial records, and suppliers) are accessible only to the owner of the barber shop.
 * - Public listing of users is disallowed.
 * - The `tickets` collection is writeable for logged-in users.
 * - The `documents` collection is publicly readable.
 *
 * Denormalization for Authorization:
 * - The `barberShopId` is implicitly denormalized in subcollections under `/barberShops/{barberShopId}`.
 *   This enables simple checks using `isBarberShopOwner(barberShopId)` and avoids costly `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isBarberShopOwner(barberShopId) {
        return exists(/databases/$(database)/documents/barberShops/$(barberShopId)) && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile.
     *   request.auth.uid: 'user123', request.resource.data.id: 'user123'
     * @deny (create) User with UID 'user123' cannot create a profile for 'user456'.
     *   request.auth.uid: 'user123', request.resource.data.id: 'user456'
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /admins/{adminId} collection.
     * @path /admins/{adminId}
     * @allow (create) An admin user can create its profile.
     * @deny (create) A non admin user cannot create an admin profile.
     * @principle Enforces admin role for writes.
     */
    match /admins/{adminId} {
      allow get: if false; // No one can get a list of admins directly
      allow list: if false;
      allow create: if false; // No one can create an admin directly
      allow update: if false; // No one can update an admin directly
      allow delete: if false; // No one can delete an admin directly
    }

    /**
     * @description Rules for the /barberShops/{barberShopId} collection.
     * @path /barberShops/{barberShopId}
     * @allow (create) User with UID 'user123' can create a barber shop with ownerId 'user123'.
     *   request.auth.uid: 'user123', request.resource.data.ownerId: 'user123'
     * @deny (create) User with UID 'user123' cannot create a barber shop with ownerId 'user456'.
     *   request.auth.uid: 'user123', request.resource.data.ownerId: 'user456'
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isBarberShopOwner(barberShopId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Rules for the /barberShops/{barberShopId}/products/{productId} collection.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) Owner of barber shop 'shop123' can create a product.
     * @deny (create) User who is not the owner of barber shop 'shop123' cannot create a product.
     * @principle Restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Rules for the /barberShops/{barberShopId}/customers/{customerId} collection.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) Owner of barber shop 'shop123' can create a customer.
     * @deny (create) User who is not the owner of barber shop 'shop123' cannot create a customer.
     * @principle Restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Rules for the /barberShops/{barberShopId}/barbers/{barberId} collection.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) Owner of barber shop 'shop123' can create a barber.
     * @deny (create) User who is not the owner of barber shop 'shop123' cannot create a barber.
     * @principle Restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Rules for the /barberShops/{barberShopId}/appointments/{appointmentId} collection.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) Owner of barber shop 'shop123' can create an appointment.
     * @deny (create) User who is not the owner of barber shop 'shop123' cannot create an appointment.
     * @principle Restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Rules for the /barberShops/{barberShopId}/services/{serviceId} collection.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) Owner of barber shop 'shop123' can create a service.
     * @deny (create) User who is not the owner of barber shop 'shop123' cannot create a service.
     * @principle Restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Rules for the /barberShops/{barberShopId}/suppliers/{supplierId} collection.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) Owner of barber shop 'shop123' can create a supplier.
     * @deny (create) User who is not the owner of barber shop 'shop123' cannot create a supplier.
     * @principle Restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Rules for the /barberShops/{barberShopId}/financialRecords/{financialRecordId} collection.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) Owner of barber shop 'shop123' can create a financial record.
     * @deny (create) User who is not the owner of barber shop 'shop123' cannot create a financial record.
     * @principle Restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

     /**
      * @description Rules for the /tickets/{ticketId} collection.
      * @path /tickets/{ticketId}
      * @allow (create) A logged in user can create a support ticket.
      * @deny (create) A non logged in user cannot create a ticket.
      */
    match /tickets/{ticketId} {
        allow get: if true; // TODO: Implement more granular access control
        allow list: if true; // TODO: Implement more granular access control
        allow create: if isSignedIn();
        allow update: if false; // TODO: Implement more granular access control
        allow delete: if false; // TODO: Implement more granular access control
    }

     /**
      * @description Rules for the /documents/{documentId} collection.
      * @path /documents/{documentId}
      */
    match /documents/{documentId} {
        allow get: if true;
        allow list: if true;
        allow create: if false; // TODO: Implement more granular access control
        allow update: if false; // TODO: Implement more granular access control
        allow delete: if false; // TODO: Implement more granular access control
    }
  }
}
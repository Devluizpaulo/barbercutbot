rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================
    // Helper Functions
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isBarberShopOwner(barberShopId) {
      return isAuthenticated() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // User Profiles
    // =============================================
    match /users/{userId} {
      // Admins can read/write any profile, users can only manage their own.
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Allow any authenticated user to create their OWN profile document.
      // This is crucial for the signup flow.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
    }

    // =============================================
    // Barber Shops (Tenants)
    // =============================================
    match /barberShops/{barberShopId} {
      // Read: Owner of the shop or an admin can read.
      allow get: if isBarberShopOwner(barberShopId) || isAdmin();
      
      // List: Only admins can list all shops.
      // A specific user can only query for shops they own.
      allow list: if isAdmin();
      
      // Create: Any authenticated user can create a new shop.
      allow create: if isAuthenticated();
      
      // Update/Delete: Only the owner or an admin can modify/delete.
      allow update, delete: if isBarberShopOwner(barberShopId) || isAdmin();

      // =============================================
      // Subcollections within a Barber Shop
      // =============================================
      match /{subcollection}/{docId} {
        // Any subcollection document (appointments, clients, etc.)
        // can only be accessed by the owner of the parent shop or an admin.
        allow read, write, delete: if isBarberShopOwner(barberShopId) || isAdmin();
      }
    }
    
    // =============================================
    // CPanel Collections (Admin Only)
    // =============================================
    
    // Admin Logs: Secure collection for administrative actions.
    match /adminLogs/{logId} {
      // Anyone authenticated can create a log entry (needed for failed login attempts).
      allow create: if isAuthenticated();
      
      // Only admins can read logs.
      allow read, list: if isAdmin();
      
      // Logs are immutable.
      allow update, delete: if false;
    }

    // Tickets: For customer support.
    match /tickets/{ticketId} {
      // Owners can create tickets for their shops. Admins can manage all.
      allow create: if ownsBarberShop(request.resource.data.shopId);
      allow read, update: if ownsBarberShop(resource.data.shopId) || isAdmin();
      allow list: if isAdmin();
    }
  }
}

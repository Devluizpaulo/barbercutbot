rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile document at /users/user123 if the document's id field also contains "user123".
     * @allow (get) - User with UID 'user123' can read their profile document at /users/user123.
     * @allow (update) - User with UID 'user123' can update their profile document at /users/user123.
     * @allow (delete) - User with UID 'user123' can delete their profile document at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a document at /users/user123.
     * @deny (get) - User with UID 'user456' cannot read the document at /users/user123.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree. Validates relational integrity between documents.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows the owner to read and write barber shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) - User with UID 'user123' can create a barber shop document if they are the owner.
     * @allow (get) - User with UID 'user123' can read a barber shop document if they are the owner.
     * @allow (update) - User with UID 'user123' can update a barber shop document if they are the owner.
     * @allow (delete) - User with UID 'user123' can delete a barber shop document if they are the owner.
     * @deny (create) - User with UID 'user456' cannot create a barber shop document for 'user123'.
     * @deny (get) - User with UID 'user456' cannot read a barber shop document owned by 'user123'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /barberShops/{barberShopId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }

      function isCreatingOwner() {
        return request.auth.uid == request.resource.data.ownerId;
      }

      allow get: if isSignedIn() && isOwner();
      allow list: if false;
      allow create: if isSignedIn() && isCreatingOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Allows the barber shop owner to read and write customer data for their shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) - Barber shop owner 'user123' can create a customer document in their shop.
     * @allow (get) - Barber shop owner 'user123' can read a customer document in their shop.
     * @allow (update) - Barber shop owner 'user123' can update a customer document in their shop.
     * @allow (delete) - Barber shop owner 'user123' can delete a customer document in their shop.
     * @deny (create) - User 'user456' cannot create a customer document in 'user123's shop.
     * @deny (get) - User 'user456' cannot read a customer document in 'user123's shop.
     * @principle Enforces ownership via the barberShopId path and restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getBarberShop() {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId));
      }

      function isBarberShopOwner() {
        return getBarberShop().data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner();
      allow list: if isSignedIn() && isBarberShopOwner();
      allow create: if isSignedIn() && isBarberShopOwner();
      allow update: if isSignedIn() && isBarberShopOwner();
      allow delete: if isSignedIn() && isBarberShopOwner();
    }

    /**
     * @description Allows the barber shop owner to read and write barber data for their shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) - Barber shop owner 'user123' can create a barber document in their shop.
     * @allow (get) - Barber shop owner 'user123' can read a barber document in their shop.
     * @allow (update) - Barber shop owner 'user123' can update a barber document in their shop.
     * @allow (delete) - Barber shop owner 'user123' can delete a barber document in their shop.
     * @deny (create) - User 'user456' cannot create a barber document in 'user123's shop.
     * @deny (get) - User 'user456' cannot read a barber document in 'user123's shop.
     * @principle Enforces ownership via the barberShopId path and restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getBarberShop() {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId));
      }

      function isBarberShopOwner() {
        return getBarberShop().data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner();
      allow list: if isSignedIn() && isBarberShopOwner();
      allow create: if isSignedIn() && isBarberShopOwner();
      allow update: if isSignedIn() && isBarberShopOwner();
      allow delete: if isSignedIn() && isBarberShopOwner();
    }

    /**
     * @description Allows the barber shop owner to read and write appointment data for their shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) - Barber shop owner 'user123' can create an appointment document in their shop.
     * @allow (get) - Barber shop owner 'user123' can read an appointment document in their shop.
     * @allow (update) - Barber shop owner 'user123' can update an appointment document in their shop.
     * @allow (delete) - Barber shop owner 'user123' can delete an appointment document in their shop.
     * @deny (create) - User 'user456' cannot create an appointment document in 'user123's shop.
     * @deny (get) - User 'user456' cannot read an appointment document in 'user123's shop.
     * @principle Enforces ownership via the barberShopId path and restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getBarberShop() {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId));
      }

      function isBarberShopOwner() {
        return getBarberShop().data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner();
      allow list: if isSignedIn() && isBarberShopOwner();
      allow create: if isSignedIn() && isBarberShopOwner();
      allow update: if isSignedIn() && isBarberShopOwner();
      allow delete: if isSignedIn() && isBarberShopOwner();
    }

    /**
     * @description Allows the barber shop owner to read and write service data for their shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) - Barber shop owner 'user123' can create a service document in their shop.
     * @allow (get) - Barber shop owner 'user123' can read a service document in their shop.
     * @allow (update) - Barber shop owner 'user123' can update a service document in their shop.
     * @allow (delete) - Barber shop owner 'user123' can delete a service document in their shop.
     * @deny (create) - User 'user456' cannot create a service document in 'user123's shop.
     * @deny (get) - User 'user456' cannot read a service document in 'user123's shop.
     * @principle Enforces ownership via the barberShopId path and restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getBarberShop() {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId));
      }

      function isBarberShopOwner() {
        return getBarberShop().data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner();
      allow list: if isSignedIn() && isBarberShopOwner();
      allow create: if isSignedIn() && isBarberShopOwner();
      allow update: if isSignedIn() && isBarberShopOwner();
      allow delete: if isSignedIn() && isBarberShopOwner();
    }

    /**
     * @description Allows the barber shop owner to read and write supplier data for their shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) - Barber shop owner 'user123' can create a supplier document in their shop.
     * @allow (get) - Barber shop owner 'user123' can read a supplier document in their shop.
     * @allow (update) - Barber shop owner 'user123' can update a supplier document in their shop.
     * @allow (delete) - Barber shop owner 'user123' can delete a supplier document in their shop.
     * @deny (create) - User 'user456' cannot create a supplier document in 'user123's shop.
     * @deny (get) - User 'user456' cannot read a supplier document in 'user123's shop.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getBarberShop() {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId));
      }

      function isBarberShopOwner() {
        return getBarberShop().data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner();
      allow list: if isSignedIn() && isBarberShopOwner();
      allow create: if isSignedIn() && isBarberShopOwner();
      allow update: if isSignedIn() && isBarberShopOwner();
      allow delete: if isSignedIn() && isBarberShopOwner();
    }

    /**
     * @description Allows the barber shop owner to read and write financial record data for their shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) - Barber shop owner 'user123' can create a financial record document in their shop.
     * @allow (get) - Barber shop owner 'user123' can read a financial record document in their shop.
     * @allow (update) - Barber shop owner 'user123' can update a financial record document in their shop.
     * @allow (delete) - Barber shop owner 'user123' can delete a financial record document in their shop.
     * @deny (create) - User 'user456' cannot create a financial record document in 'user123's shop.
     * @deny (get) - User 'user456' cannot read a financial record document in 'user123's shop.
     * @principle Enforces ownership via the barberShopId path and restricts access to the barber shop owner.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getBarberShop() {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId));
      }

      function isBarberShopOwner() {
        return getBarberShop().data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isBarberShopOwner();
      allow list: if isSignedIn() && isBarberShopOwner();
      allow create: if isSignedIn() && isBarberShopOwner();
      allow update: if isSignedIn() && isBarberShopOwner();
      allow delete: if isSignedIn() && isBarberShopOwner();
    }
  }
}
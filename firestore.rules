/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset enforces a multi-tenant security model for a barber shop SaaS application.
 * All data is scoped to a specific barber shop and access is controlled based on ownership or explicit shop membership.
 *
 * @data-structure
 * - /users/{userId}: Stores user profiles; accessible only to the user themselves.
 * - /admins/{adminId}: Stores admin user IDs; accessible only to admins.
 * - /barberShops/{barberShopId}: Stores barber shop data; accessible only to the shop owner.
 * - /barberShops/{barberShopId}/{collection}/{documentId}: Stores data related to a specific barber shop.
 *
 * @key-security-decisions
 * - Strict user ownership for /users/{userId} and /admins/{adminId}.
 * - Barber shop ownership enforced via the `ownerId` field in `/barberShops/{barberShopId}`.
 * - Subcollections under `/barberShops/{barberShopId}` inherit shop-level access control.
 * - No public listing of users or barber shops is allowed.
 *
 * @denormalization-for-authorization
 * - Subcollections under `/barberShops/{barberShopId}` implicitly denormalize the `barberShopId` via the path. This is used for secure list operations (QAPs) and authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) if request.auth.uid == userId
     * @deny (get, create, update, delete, list) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure admin profiles. Only admins can read or write their own profile.
     * @path /admins/{adminId}
     * @allow (get, create, update, delete, list) if isAdmin()
     * @deny (get, create, update, delete, list) if !isAdmin()
     * @principle Enforces document ownership for writes.
     */
    match /admins/{adminId} {
      allow get: if isAdmin(adminId);
      allow list: if false;
      allow create: if isAdmin(adminId);
      allow update: if isAdmin(adminId);
      allow delete: if isAdmin(adminId);
    }

    /**
     * @description Secure barber shop profiles. Only the owner can read or write their shop profile.
     * @path /barberShops/{barberShopId}
     * @allow (get, create, update, delete, list) if isOwner(resource.data.ownerId)
     * @deny (get, create, update, delete, list) if !isOwner(resource.data.ownerId)
     * @principle Enforces document ownership for writes.
     */
    match /barberShops/{barberShopId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure product data for a specific barber shop.
     * @path /barberShops/{barberShopId}/products/{productId}
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure customer data for a specific barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure barber data for a specific barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure appointment data for a specific barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure service data for a specific barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure supplier data for a specific barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure financial records for a specific barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId);
      allow delete: if isBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure support tickets.  Any logged-in user can read the support tickets.
     * @path /tickets/{ticketId}
     */
    match /tickets/{ticketId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isAdmin(request.auth.uid);  // Only admins can update tickets
      allow delete: if false; // No one can delete tickets
    }
       /**
     * @description Secure platform documents.
     * @path /documents/{documentId}
     */
    match /documents/{documentId} {
      allow get: if isAdmin(request.auth.uid) || isSignedIn();
      allow list: if false;
      allow create: if isAdmin(request.auth.uid);
      allow update: if isAdmin(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the document, based on the provided userId.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the document and if the document exists.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Checks if the current user is the owner of the barber shop, based on the provided barberShopId.
     * @param {string} barberShopId The barber shop ID to compare against the resource data.
     * @return {boolean} True if the user is the barber shop owner, false otherwise.
     */
    function isBarberShopOwner(barberShopId) {
      return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

        /**
         * @description Checks if the current user is the owner of the barber shop, and if the resource exists.
         * @param {string} barberShopId The barber shop ID.
         * @return {boolean} True if the user is the owner and the document exists, false otherwise.
         */
    function isExistingBarberShopOwner(barberShopId) {
         return isBarberShopOwner(barberShopId) && resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Checks if the current user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin(adminId) {
          return isSignedIn() && exists(/databases/$(database)/documents/admins/$(adminId));
    }
  }
}
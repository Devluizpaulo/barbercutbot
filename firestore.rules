rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper Functions
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getRole(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == 'admin';
    }
    
    function isShopOwner(shopId) {
        return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // Global Rules (Admin Override)
    // =============================================
    match /{document=**} {
      // Admins can read and write all documents
      allow read, write: if isAdmin();
    }

    // =============================================
    // Collection-Specific Rules
    // =============================================

    // Users Collection
    // Each user can read/write their own profile.
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      // Deny creation/deletion via this path. User creation is handled by Cloud Functions.
      allow create, delete: if false;
    }

    // Barber Shops Collection
    match /barberShops/{shopId} {
      // CORRECTED RULE: Allow any authenticated user to create a shop,
      // as long as they set themselves as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      // Only the shop owner can read, update, or delete their own shop.
      allow read, update, delete: if isShopOwner(shopId);

      // Sub-collections within a barber shop
      match /{collection}/{docId} {
        // Only the owner of the parent shop can read or write to its sub-collections.
        allow read, write: if isShopOwner(shopId);
      }
    }
    
    // Admin Logs Collection
    match /adminLogs/{logId} {
        // Any authenticated user can create a log (needed for failed login attempts).
        allow create: if isSignedIn();
        // Only admins can read logs.
        allow list, get: if isAdmin();
        // Logs are immutable.
        allow update, delete: if false;
    }
    
     // Tickets Collection
    match /tickets/{ticketId} {
        // A user can create a ticket if they are the owner of the associated shop.
        allow create: if isSignedIn() && isShopOwner(request.resource.data.shopId);
        // A user can read their own tickets. Admins can read any ticket.
        allow read: if isShopOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.shopId) || isAdmin();
        // Only admins can update or delete tickets.
        allow update, delete: if isAdmin();
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // =============================================
    // ADMIN GOD-MODE RULE (Highest Priority)
    // =============================================
    // O Administrador tem acesso irrestrito a todos os documentos.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // =============================================
    // GENERAL USER RULES
    // =============================================
    // Qualquer usuário autenticado (isSignedIn) pode ler e escrever nos seus próprios dados
    // dentro de uma loja. A UI é responsável por garantir que um 'owner' só veja/edite
    // os dados da sua própria loja.
    // Esta regra é mais permissiva, confiando que o frontend fará as queries corretas.

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn();
    }
    
    match /barberShops/{shopId}/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /barberShops/{shopId} {
      allow read, write: if isSignedIn();
    }
    
    match /tickets/{ticketId} {
      allow read, write: if isSignedIn();
    }
  }
}

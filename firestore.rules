rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their profile with ID 'user_abc'.
     * @allow (get, list, update, delete) - User with UID 'user_abc' can read, update, and delete their profile with ID 'user_abc'.
     * @deny (create) - User with UID 'user_abc' cannot create a profile with ID 'user_xyz'.
     * @deny (get, list, update, delete) - User with UID 'user_abc' cannot read, update, or delete profile with ID 'user_xyz'.
     * @principle Enforces user-ownership for user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the authenticated user is the owner of the resource.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of an existing resource.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      // Allow a user to create their own profile.
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow a user to read their own profile.
      allow get: if isOwner(userId);

      // Allow a user to list their own profile (This is likely not needed but included for completeness).
      allow list: if isOwner(userId);

      // Allow a user to update their own profile, but ensure the ID (owner) cannot be changed.
      allow update: if isOwner(userId);

      // Allow a user to delete their own profile.
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to barber shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) - User with UID 'user_abc' can create a barber shop and set themselves as the owner.
     * @allow (get, list, update, delete) - User with UID 'user_abc' can read, update, and delete a barber shop they own.
     * @deny (create) - User with UID 'user_abc' cannot create a barber shop and set someone else as the owner.
     * @deny (get, list, update, delete) - User with UID 'user_abc' cannot read, update, or delete a barber shop owned by someone else.
     * @principle Enforces ownership for barber shops, linking them to the user who created them.
     */
    match /barberShops/{barberShopId} {
      // Helper function to check if the authenticated user is the owner of the barber shop.
      function isBarberShopOwner(barberShopId) {
        return request.auth != null && request.auth.uid == get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId;
      }

      // Helper function to check if the authenticated user is the owner of an existing barber shop.
      function isExistingBarberShopOwner(barberShopId) {
        return request.auth != null && request.auth.uid == get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId;
      }

      // Allow a user to create a barber shop if they are setting themselves as the owner.
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

      // Allow anyone to read barber shop data.
      allow get, list: if true;

      // Allow the barber shop owner to update the barber shop.
      allow update: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to delete the barber shop.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to customer data for a specific barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create, get, list, update, delete) - The owner of the barber shop can manage customer data.
     * @deny (create, get, list, update, delete) - Users who are not the barber shop owner cannot manage customer data.
     * @principle Enforces barber shop ownership for customer data management.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      // Helper function to check if the authenticated user is the owner of the parent barber shop.
      function isBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Helper function to check if the authenticated user is the owner of the barber shop.
      function isExistingBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Allow the barber shop owner to create customer data.
      allow create: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to read customer data.
      allow get, list: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to update customer data.
      allow update: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to delete customer data.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to barber data for a specific barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create, get, list, update, delete) - The owner of the barber shop can manage barber data.
     * @deny (create, get, list, update, delete) - Users who are not the barber shop owner cannot manage barber data.
     * @principle Enforces barber shop ownership for barber data management.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      // Helper function to check if the authenticated user is the owner of the parent barber shop.
      function isBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Helper function to check if the authenticated user is the owner of the barber shop.
      function isExistingBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Allow the barber shop owner to create barber data.
      allow create: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to read barber data.
      allow get, list: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to update barber data.
      allow update: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to delete barber data.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to appointment data for a specific barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create, get, list, update, delete) - The owner of the barber shop can manage appointment data.
     * @deny (create, get, list, update, delete) - Users who are not the barber shop owner cannot manage appointment data.
     * @principle Enforces barber shop ownership for appointment data management.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      // Helper function to check if the authenticated user is the owner of the parent barber shop.
      function isBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Helper function to check if the authenticated user is the owner of the barber shop.
      function isExistingBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Allow the barber shop owner to create appointment data.
      allow create: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to read appointment data.
      allow get, list: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to update appointment data.
      allow update: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to delete appointment data.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to service data for a specific barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create, get, list, update, delete) - The owner of the barber shop can manage service data.
     * @deny (create, get, list, update, delete) - Users who are not the barber shop owner cannot manage service data.
     * @principle Enforces barber shop ownership for service data management.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      // Helper function to check if the authenticated user is the owner of the parent barber shop.
      function isBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Helper function to check if the authenticated user is the owner of the barber shop.
      function isExistingBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Allow the barber shop owner to create service data.
      allow create: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to read service data.
      allow get, list: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to update service data.
      allow update: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to delete service data.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to financial record data for a specific barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create, get, list, update, delete) - The owner of the barber shop can manage financial record data.
     * @deny (create, get, list, update, delete) - Users who are not the barber shop owner cannot manage financial record data.
     * @principle Enforces barber shop ownership for financial record data management.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      // Helper function to check if the authenticated user is the owner of the parent barber shop.
      function isBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Helper function to check if the authenticated user is the owner of the barber shop.
      function isExistingBarberShopOwner(barberShopId) {
        return request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      // Allow the barber shop owner to create financial record data.
      allow create: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to read financial record data.
      allow get, list: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to update financial record data.
      allow update: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

      // Allow the barber shop owner to delete financial record data.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isShopOwner(shopId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/barberShops/$(shopId)) &&
        get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // ADMIN GOD-MODE (HIGHEST PRIORITY)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // =============================================
    // USER AND SHOP RULES
    // =============================================

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
    }

    match /barberShops/{shopId} {
      // Owner can create their own shop.
      allow create: if request.auth.uid == request.resource.data.ownerId;
      
      // Let shop owner read, update, or delete their own shop document.
      // This is safe because get() is allowed for non-list operations.
      allow read, update, delete: if isShopOwner(shopId);

      // A user can ONLY list shops that they own.
      // The query on the client MUST include `where('ownerId', '==', request.auth.uid)`.
      // This rule is valid because it does NOT use get() or exists().
      allow list: if isSignedIn() && request.query.ownerId == request.auth.uid;
    }
    
    // =============================================
    // SUB-COLLECTION RULES (CORRECTED)
    // =============================================

    match /barberShops/{shopId}/{subcollection}/{docId} {
        // GET, CREATE, UPDATE, DELETE: Safe to use isShopOwner because it operates on a single document.
        allow get, write: if isShopOwner(shopId);

        // LIST: NOT safe to use isShopOwner. Must rely on query constraints.
        // The client query MUST contain `where('barberShopId', '==', shopId)` for this to work.
        allow list: if isSignedIn() && request.query.barberShopId == shopId;
    }
    
    // =============================================
    // PLATFORM-WIDE COLLECTIONS
    // =============================================

    match /adminLogs/{logId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, write: if request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId || isAdmin();
    }
  }
}

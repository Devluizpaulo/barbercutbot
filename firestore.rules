/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for most collections,
 *              with barber shop data segregated and secured by barberShopId. It prioritizes
 *              authorization independence and prevents unauthorized data access.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, owned by the user.
 * - /admins/{adminId}: List of admin user IDs.
 * - /barberShops/{barberShopId}: Barber shop data, owned by the user specified in ownerId.
 * - /barberShops/{barberShopId}/...: Subcollections related to a specific barber shop.
 * - /tickets/{ticketId}: Support tickets, accessible with certain conditions.
 * - /documents/{documentId}: Platform-wide legal documents, publicly readable.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied to prevent unauthorized access to user data.
 * - Most subcollections under /barberShops/{barberShopId} are secured by ownerId, ensuring
 *   that only the owner of the barber shop can manage the associated data.
 * - Public read access is granted to the /documents collection for legal documents.
 *
 * Denormalization for Authorization:
 * - Subcollections under /barberShops/{barberShopId} implicitly denormalize the barberShopId
 *   in the path, enabling efficient query-based authorization (QAPs). This removes the need
 *   for costly `get()` calls in security rules.
 *   e.g. /barberShops/{barberShopId}/customers/{customerId} has the barberShopId implicitly denormalized by the path.
 *
 * Structural Segregation:
 * - Private data (e.g., user profiles) is stored in user-specific subcollections, while
 *   publicly readable data (e.g., legal documents) is stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource, and that the document exists.
     *              This is for update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is an admin.
     */
    function isAdmin() {
      return exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    /**
     * @description Helper function to determine if the request originates from the BarberShop owner.
     */
    function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Rule for /users/{userId} documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile.
     * @deny (create) User with UID 'user123' cannot create a profile for 'user456'.
     * @allow (get) User with UID 'user123' can read their own profile.
     * @deny (get) User with UID 'user123' cannot read the profile of 'user456'.
     * @allow (update) User with UID 'user123' can update their own profile.
     * @deny (update) User with UID 'user123' cannot update the profile of 'user456'.
     * @allow (delete) User with UID 'user123' can delete their own profile.
     * @deny (delete) User with UID 'user123' cannot delete the profile of 'user456'.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for /admins/{adminId} documents.
     * @path /admins/{adminId}
     */
    match /admins/{adminId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rule for /barberShops/{barberShopId} documents.
     * @path /barberShops/{barberShopId}
     * @allow (create) User with UID 'user123' can create a barber shop if they are the owner.
     * @deny (create) User with UID 'user123' cannot create a barber shop if they are not the owner.
     * @allow (get) User with UID 'user123' can read a barber shop if they are the owner.
     * @deny (get) User with UID 'user123' cannot read a barber shop if they are not the owner.
     * @allow (update) User with UID 'user123' can update a barber shop if they are the owner.
     * @deny (update) User with UID 'user123' cannot update a barber shop if they are not the owner.
     * @allow (delete) User with UID 'user123' can delete a barber shop if they are the owner.
     * @deny (delete) User with UID 'user123' cannot delete a barber shop if they are not the owner.
     * @principle Enforces document ownership for all operations on barber shops.
     */
    match /barberShops/{barberShopId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rule for /barberShops/{barberShopId}/products/{productId} documents.
     * @path /barberShops/{barberShopId}/products/{productId}
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rule for /barberShops/{barberShopId}/customers/{customerId} documents.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rule for /barberShops/{barberShopId}/barbers/{barberId} documents.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rule for /barberShops/{barberShopId}/appointments/{appointmentId} documents.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rule for /barberShops/{barberShopId}/services/{serviceId} documents.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rule for /barberShops/{barberShopId}/suppliers/{supplierId} documents.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rule for /barberShops/{barberShopId}/financialRecords/{financialRecordId} documents.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

     /**
      * @description Rule for /tickets/{ticketId} documents.
      * @path /tickets/{ticketId}
      */
    match /tickets/{ticketId} {
        allow get: if isAdmin(); // Only admins can read tickets
        allow list: if isAdmin(); // Only admins can list tickets
        allow create: if isSignedIn(); // Any authenticated user can create a ticket
        allow update: if isAdmin() && resource != null; // Only admins can update tickets
        allow delete: if isAdmin() && resource != null; // Only admins can delete tickets
    }

    /**
     * @description Rule for /documents/{documentId} documents.
     * @path /documents/{documentId}
     */
    match /documents/{documentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}
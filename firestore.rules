
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isShopOwner(shopId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/barberShops/$(shopId)) &&
        get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // ADMIN GOD-MODE (HIGHEST PRIORITY)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // =============================================
    // USER AND SHOP RULES
    // =============================================

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
    }

    match /barberShops/{shopId} {
      // Owner can create and manage their own shop document.
      allow create: if request.auth.uid == request.resource.data.ownerId;
      
      // Let shop owner do anything to their own shop document.
      // This covers read, update, delete for the main doc.
      allow read, update, delete: if isShopOwner(shopId);

      // A user can only list shops that they own.
      // The query on the client MUST include `where('ownerId', '==', request.auth.uid)`
      allow list: if isSignedIn() && request.query.ownerId == request.auth.uid;
    }
    
    // =============================================
    // SUB-COLLECTION RULES (SIMPLIFIED)
    // =============================================

    match /barberShops/{shopId}/{subcollection}/{docId} {
        // The owner of the shop can do anything (read, list, write)
        // in any subcollection of their shop.
        // The `get()` call is allowed for `read` and `write` operations.
        // It is NOT allowed for `list`, but since we are not defining a separate `list` rule,
        // Firestore falls back to the `read` rule. This can be inefficient for large
        // collections but guarantees functionality. The client-side queries SHOULD
        // still include `where('barberShopId', '==', shopId)` for performance.
        allow read, write: if isShopOwner(shopId);
    }
    
    // =============================================
    // PLATFORM-WIDE COLLECTIONS
    // =============================================

    match /adminLogs/{logId} {
      allow create: if isSignedIn();
      // Admins can do anything with logs
      allow read, write: if isAdmin();
    }

    match /tickets/{ticketId} {
      // User can create their own ticket.
      allow create: if request.auth.uid == request.resource.data.userId;
      // Owner of ticket or admin can read/write.
      allow read, write: if request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId || isAdmin();
    }
  }
}

/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description
 * This ruleset enforces a strict user-ownership model for personal data and
 * shop-ownership model for barber shop data, with authorization checks based on
 * the authenticated user's UID. It prioritizes security and data isolation
 * within a multi-tenant SaaS application.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, accessible only by the user.
 * - /barberShops/{barberShopId}: Barber shop data, owned by a specific user.
 * - /barberShops/{barberShopId}/*: Subcollections contain data related to a specific barber shop and
 *   are accessible only to the shop owner. This includes products, customers, barbers, appointments, services, suppliers and financial records.
 * - /tickets/{ticketId}: Support tickets.
 * - /documents/{documentId}: Platform-wide legal documents.
 *
 * Key Security Decisions:
 * - User data is strictly controlled by the user's UID.
 * - Barber shop data is owned by a specific user, enforced via the `ownerId` field.
 * - Subcollections under barberShops inherit the barberShopId from the path.
 * - Listing of users is disallowed.
 * - Write operations are explicitly secured to prevent unauthorized data modification.
 *
 * Denormalization for Authorization:
 * - The `barberShopId` is implicitly denormalized into the paths of subcollections under `/barberShops/{barberShopId}`.
 *   This allows for efficient security rules without requiring additional `get()` calls.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the resource.
     * @param {string} userId - The user ID to compare against.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Allows creating an admin user.
     * @path /admins/{adminId}
     * @allow (create) - If the authenticated user has the 'admin' custom claim.
     * @deny (create) - If the authenticated user does not have the 'admin' custom claim.
     * @principle Enforces admin-only creation.
     */
    match /admins/{adminId} {
      allow create: if request.auth.token.admin == true;
      allow get, list, update, delete: if false;
    }

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) - If the authenticated user's UID matches the `userId` (self-creation).
     * @allow (get, list) - If the authenticated user's UID matches the `userId` (owner-only read).
     * @allow (update, delete) - If the authenticated user's UID matches the `userId` and the document exists (owner-only write).
     * @deny (create) - If the authenticated user's UID does not match the `userId`.
     * @deny (get, list, update, delete) - If the authenticated user's UID does not match the `userId`.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to barber shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) - If the authenticated user is creating their own barber shop (request.auth.uid == request.resource.data.ownerId).
     * @allow (get, list) - If the shop data is readable by everyone
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all write operations.
     */
    match /barberShops/{barberShopId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow get, list: if true;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to product data within a barber shop.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (create) - If the authenticated user is the owner of the barber shop.
     * @allow (get, list) - If the authenticated user is the owner of the barber shop.
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, get, list, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all operations on products.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow get, list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Controls access to customer data within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) - If the authenticated user is the owner of the barber shop.
     * @allow (get, list) - If the authenticated user is the owner of the barber shop.
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, get, list, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all operations on customers.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow get, list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Controls access to barber data within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) - If the authenticated user is the owner of the barber shop.
     * @allow (get, list) - If the authenticated user is the owner of the barber shop.
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, get, list, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all operations on barbers.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow get, list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Controls access to appointment data within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) - If the authenticated user is the owner of the barber shop.
     * @allow (get, list) - If the authenticated user is the owner of the barber shop.
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, get, list, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all operations on appointments.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow get, list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Controls access to service data within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) - If the authenticated user is the owner of the barber shop.
     * @allow (get, list) - If the authenticated user is the owner of the barber shop.
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, get, list, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all operations on services.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow get, list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Controls access to supplier data within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) - If the authenticated user is the owner of the barber shop.
     * @allow (get, list) - If the authenticated user is the owner of the barber shop.
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, get, list, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all operations on suppliers.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow get, list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Controls access to financial record data within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) - If the authenticated user is the owner of the barber shop.
     * @allow (get, list) - If the authenticated user is the owner of the barber shop.
     * @allow (update, delete) - If the authenticated user is the owner of the barber shop.
     * @deny (create, get, list, update, delete) - If the authenticated user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for all operations on financial records.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow create: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow get, list: if isOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow update: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
      allow delete: if isExistingOwner(get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId);
    }

    /**
     * @description Controls access to support tickets.
     * @path /tickets/{ticketId}
     * @allow (get, list) - Allow public read access to tickets.
     * @allow (create) - If the user is signed in.
     * @allow (update, delete) - Deny all updates and deletes.
     * @principle Allows public read access but restricts modifications.
     */
    match /tickets/{ticketId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Controls access to legal documents.
     * @path /documents/{documentId}
     * @allow (get, list) - Allow public read access to documents.
     * @allow (create, update, delete) - Deny all writes.
     * @principle Allows public read access but restricts modifications.
     */
    match /documents/{documentId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}
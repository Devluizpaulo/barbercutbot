/**
 * @fileoverview Firestore Security Rules for the Barber Shop SaaS application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for users and their associated barber shops,
 * and a barber shop ownership model for data nested under barber shops. It also supports scoped admin access.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the authenticated user.
 * - /barberShops/{barberShopId}: Stores barber shop data, accessible only to the owner of the barber shop.
 * - /barberShops/{barberShopId}/[...]: Subcollections under barberShops are accessible only to the owner of the barber shop.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user profiles.
 * - Users can only read and write barber shops they own (ownerId field matches their UID).
 * - Subcollections under barber shops inherit the barber shop ownership.
 * - Public listing of users is disallowed.
 * - Data validation is relaxed in this prototyping phase, focusing on authorization and relational integrity.
 *
 * Denormalization for Authorization:
 * The `ownerId` field in the `barberShops` collection is crucial. It enables direct ownership checks
 * without requiring additional reads. Subcollections under `/barberShops/{barberShopId}` implicitly denormalize the `barberShopId`,
 * which is used to authorize data access to the resources.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle N/A (Helper function)
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle N/A (Helper function)
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle N/A (Helper function)
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the barber shop.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle N/A (Helper function)
     */
    function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Checks if the authenticated user is an admin.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     */
    function isAdmin() {
        return request.auth.token.admin == true;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is the owner of the profile (UID matches userId).
     * @deny (get, create, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for barber shops.
     * @path /barberShops/{barberShopId}
     * @allow (get, list) if true (public read).
     * @allow (create) if the ownerId in the request matches the authenticated user's UID.
     * @allow (update, delete) if the user is the owner of the barber shop.
     * @deny (create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces owner-only writes for barber shops, public reads.
     */
    match /barberShops/{barberShopId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for products within a barber shop.
     * @path /barberShops/{barberShopId}/products/{productId}
     * @allow (get, list) if the user is the owner of the barber shop.
     * @allow (create, update, delete) if the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for product data.
     */
    match /barberShops/{barberShopId}/products/{productId} {
      allow get, list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for customers within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (get, list) if the user is the owner of the barber shop.
     * @allow (create, update, delete) if the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for customer data.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      allow get, list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for barbers within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (get, list) if the user is the owner of the barber shop.
     * @allow (create, update, delete) if the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for barber data.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      allow get, list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for appointments within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (get, list) if the user is the owner of the barber shop.
     * @allow (create, update, delete) if the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for appointment data.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      allow get, list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for services within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (get, list) if the user is the owner of the barber shop.
     * @allow (create, update, delete) if the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for service data.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      allow get, list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for suppliers within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (get, list) if the user is the owner of the barber shop.
     * @allow (create, update, delete) if the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for supplier data.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      allow get, list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for financial records within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (get, list) if the user is the owner of the barber shop.
     * @allow (create, update, delete) if the user is the owner of the barber shop.
     * @deny (get, list, create, update, delete) if the user is not the owner of the barber shop.
     * @principle Enforces barber shop ownership for financial record data.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      allow get, list: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow create: if isSignedIn() && isBarberShopOwner(barberShopId);
      allow update: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
      allow delete: if isSignedIn() && isBarberShopOwner(barberShopId) && resource != null;
    }
     /**
      * @description Rules for support tickets.
      * @path /tickets/{ticketId}
      * @allow (get, list, create, update) if the user is an admin.
      * @deny (get, list, create, update) if the user is not an admin.
      */
    match /tickets/{ticketId} {
        allow get, list, create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for platform documents.
     * @path /documents/{documentId}
     * @allow (get, list, create, update, delete) if the user is an admin.
     * @deny (get, list, create, update, delete) if the user is not an admin.
     */
     match /documents/{documentId} {
        allow get, list, create, update, delete: if isAdmin();
    }
  }
}
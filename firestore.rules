/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description
 * This ruleset enforces a strict user-ownership model for barber shop data,
 * ensuring that only authenticated users can access and modify data related to their
 * barber shops. Path-based ownership is used for user profiles, and the `ownerId`
 * field in BarberShop documents links shops to their owners. Subcollections under
 * `/barberShops/{barberShopId}` inherit authorization from the parent BarberShop
 * and implicitly denormalize the barberShopId from the path.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /barberShops/{barberShopId}: Stores barber shop data, owned by a specific user (ownerId).
 * - /barberShops/{barberShopId}/customers/{customerId}: Stores customer data for a specific barber shop.
 * - /barberShops/{barberShopId}/barbers/{barberId}: Stores barber data for a specific barber shop.
 * - /barberShops/{barberShopId}/appointments/{appointmentId}: Stores appointment data for a specific barber shop.
 * - /barberShops/{barberShopId}/services/{serviceId}: Stores service data for a specific barber shop.
 * - /barberShops/{barberShopId}/suppliers/{supplierId}: Stores supplier data for a specific barber shop.
 * - /barberShops/{barberShopId}/financialRecords/{financialRecordId}: Stores financial records for a specific barber shop.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data under /users/{userId}.
 * - Barber shops can only be created, updated, or deleted by their owner (ownerId).
 * - Subcollections under a barber shop inherit the barber shop's ownership.
 * - List operations are restricted to the owner of the barber shop for subcollections.
 *
 * Denormalization for Authorization:
 * - Subcollections under `/barberShops/{barberShopId}` implicitly denormalize the barberShopId from the path. This enables performant list operations that filter by the barberShopId using path-based rules, eliminating the need for expensive `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document based on the provided user ID.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own profile (request.auth.uid == userId).
     * @allow (get, update, delete) If the user is the owner of the profile.
     * @deny (create) If the user is not authenticated.
     * @deny (get, update, delete) If the user is not authenticated.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for barber shops.
     * @path /barberShops/{barberShopId}
     * @allow (create) If the user is authenticated and the ownerId matches the user's UID.
     * @allow (get, list) If true (publicly readable).
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /barberShops/{barberShopId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.ownerId);
        allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Rules for customers within a barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) If the user is authenticated.
     * @allow (get, list) If the user is the owner of the barber shop.
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Enforces barber shop ownership for customer data.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
        allow get, list: if isBarberShopOwner(barberShopId);
        allow create: if isSignedIn();
        allow update: if isBarberShopOwner(barberShopId) && resource != null;
        allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

     /**
     * @description Rules for barbers within a barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) If the user is authenticated.
     * @allow (get, list) If the user is the owner of the barber shop.
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Enforces barber shop ownership for barber data.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
        allow get, list: if isBarberShopOwner(barberShopId);
        allow create: if isSignedIn();
        allow update: if isBarberShopOwner(barberShopId) && resource != null;
        allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for appointments within a barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) If the user is authenticated.
     * @allow (get, list) If the user is the owner of the barber shop.
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Enforces barber shop ownership for appointment data.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
        allow get, list: if isBarberShopOwner(barberShopId);
        allow create: if isSignedIn();
        allow update: if isBarberShopOwner(barberShopId) && resource != null;
        allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for services within a barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) If the user is authenticated.
     * @allow (get, list) If the user is the owner of the barber shop.
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Enforces barber shop ownership for service data.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
        allow get, list: if isBarberShopOwner(barberShopId);
        allow create: if isSignedIn();
        allow update: if isBarberShopOwner(barberShopId) && resource != null;
        allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

     /**
     * @description Rules for suppliers within a barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) If the user is authenticated.
     * @allow (get, list) If the user is the owner of the barber shop.
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
        allow get, list: if isBarberShopOwner(barberShopId);
        allow create: if isSignedIn();
        allow update: if isBarberShopOwner(barberShopId) && resource != null;
        allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Rules for financial records within a barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) If the user is authenticated.
     * @allow (get, list) If the user is the owner of the barber shop.
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Enforces barber shop ownership for financial record data.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
        allow get, list: if isBarberShopOwner(barberShopId);
        allow create: if isSignedIn();
        allow update: if isBarberShopOwner(barberShopId) && resource != null;
        allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }

    /**
     * @description Helper function to check if the authenticated user is the owner of the barber shop, based on the barberShopId.
     * @param {string} barberShopId - The ID of the barber shop.
     * @return {bool} True if the user is the owner of the barber shop, false otherwise.
     */
    function isBarberShopOwner(barberShopId) {
      return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Rules for teamMembers within a barber shop.
     * @path /barberShops/{barberShopId}/teamMembers/{teamMemberId}
     * @allow (create) If the user is authenticated.
     * @allow (get, list) If the user is the owner of the barber shop.
     * @allow (update, delete) If the user is the owner of the barber shop.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Enforces barber shop ownership for teamMember data.
     */
     match /barberShops/{barberShopId}/teamMembers/{teamMemberId} {
        allow get, list: if isBarberShopOwner(barberShopId);
        allow create: if isSignedIn();
        allow update: if isBarberShopOwner(barberShopId) && resource != null;
        allow delete: if isBarberShopOwner(barberShopId) && resource != null;
    }
  }
}
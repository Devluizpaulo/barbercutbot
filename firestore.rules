/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model for most data, with barber shop owners controlling access to their shop's data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /barberShops/{barberShopId}: Stores barber shop data, accessible only to the shop owner.
 * - Subcollections under /barberShops/{barberShopId}: Contain data related to the barber shop (customers, barbers, appointments, services, suppliers, financial records), accessible only to the shop owner.
 *
 * Key Security Decisions:
 * - Users cannot list other users. This prevents unauthorized access to user profiles.
 * - Subcollections are secured based on ownership of the parent barberShop document.
 *
 * Denormalization for Authorization:
 * - The `ownerId` field is denormalized on the `/barberShops/{barberShopId}` document to avoid needing a `get()` call to the `/users/{userId}` document to check ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile at /users/user123.
     * @allow (get) User with UID 'user123' can read their profile at /users/user123.
     * @allow (update) User with UID 'user123' can update their profile at /users/user123.
     * @allow (delete) User with UID 'user123' can delete their profile at /users/user123.
     * @deny (create) User with UID 'user123' cannot create a profile at /users/user456.
     * @deny (get) User with UID 'user123' cannot read the profile at /users/user456.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      // Prevents listing of all users
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows the owner of a barber shop to manage their shop's data.
     * @path /barberShops/{barberShopId}
     * @allow (create) User with UID 'user123' can create a barber shop with ownerId 'user123'.
     * @allow (get) User with UID 'user123' can read a barber shop they own.
     * @allow (update) User with UID 'user123' can update a barber shop they own.
     * @allow (delete) User with UID 'user123' can delete a barber shop they own.
     * @deny (create) User with UID 'user123' cannot create a barber shop with ownerId 'user456'.
     * @deny (get) User with UID 'user123' cannot read a barber shop owned by 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /barberShops/{barberShopId} {
      allow get: if isBarberShopOwner(barberShopId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);

      /**
       * @description Allows the owner of a barber shop to manage customer data for their shop.
       * @path /barberShops/{barberShopId}/customers/{customerId}
       * @allow (create) Owner of barberShopId can create a customer.
       * @allow (get) Owner of barberShopId can read a customer.
       * @allow (update) Owner of barberShopId can update a customer.
       * @allow (delete) Owner of barberShopId can delete a customer.
       * @deny (create) Non-owner of barberShopId cannot create a customer.
       * @deny (get) Non-owner of barberShopId cannot read a customer.
       * @principle Enforces ownership via the barberShopId path.
       */
      match /customers/{customerId} {
        allow get: if isBarberShopOwner(barberShopId);
        allow list: if isBarberShopOwner(barberShopId);
        allow create: if isBarberShopOwner(barberShopId);
        allow update: if isExistingBarberShopOwner(barberShopId);
        allow delete: if isExistingBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner of a barber shop to manage barber data for their shop.
       * @path /barberShops/{barberShopId}/barbers/{barberId}
       * @allow (create) Owner of barberShopId can create a barber.
       * @allow (get) Owner of barberShopId can read a barber.
       * @allow (update) Owner of barberShopId can update a barber.
       * @allow (delete) Owner of barberShopId can delete a barber.
       * @deny (create) Non-owner of barberShopId cannot create a barber.
       * @deny (get) Non-owner of barberShopId cannot read a barber.
       * @principle Enforces ownership via the barberShopId path.
       */
      match /barbers/{barberId} {
        allow get: if isBarberShopOwner(barberShopId);
        allow list: if isBarberShopOwner(barberShopId);
        allow create: if isBarberShopOwner(barberShopId);
        allow update: if isExistingBarberShopOwner(barberShopId);
        allow delete: if isExistingBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner of a barber shop to manage appointment data for their shop.
       * @path /barberShops/{barberShopId}/appointments/{appointmentId}
       * @allow (create) Owner of barberShopId can create an appointment.
       * @allow (get) Owner of barberShopId can read an appointment.
       * @allow (update) Owner of barberShopId can update an appointment.
       * @allow (delete) Owner of barberShopId can delete an appointment.
       * @deny (create) Non-owner of barberShopId cannot create an appointment.
       * @deny (get) Non-owner of barberShopId cannot read an appointment.
       * @principle Enforces ownership via the barberShopId path.
       */
      match /appointments/{appointmentId} {
        allow get: if isBarberShopOwner(barberShopId);
        allow list: if isBarberShopOwner(barberShopId);
        allow create: if isBarberShopOwner(barberShopId);
        allow update: if isExistingBarberShopOwner(barberShopId);
        allow delete: if isExistingBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner of a barber shop to manage service data for their shop.
       * @path /barberShops/{barberShopId}/services/{serviceId}
       * @allow (create) Owner of barberShopId can create a service.
       * @allow (get) Owner of barberShopId can read a service.
       * @allow (update) Owner of barberShopId can update a service.
       * @allow (delete) Owner of barberShopId can delete a service.
       * @deny (create) Non-owner of barberShopId cannot create a service.
       * @deny (get) Non-owner of barberShopId cannot read a service.
       * @principle Enforces ownership via the barberShopId path.
       */
      match /services/{serviceId} {
        allow get: if isBarberShopOwner(barberShopId);
        allow list: if isBarberShopOwner(barberShopId);
        allow create: if isBarberShopOwner(barberShopId);
        allow update: if isExistingBarberShopOwner(barberShopId);
        allow delete: if isExistingBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner of a barber shop to manage supplier data for their shop.
       * @path /barberShops/{barberShopId}/suppliers/{supplierId}
       * @allow (create) Owner of barberShopId can create a supplier.
       * @allow (get) Owner of barberShopId can read a supplier.
       * @allow (update) Owner of barberShopId can update a supplier.
       * @allow (delete) Owner of barberShopId can delete a supplier.
       * @deny (create) Non-owner of barberShopId cannot create a supplier.
       * @deny (get) Non-owner of barberShopId cannot read a supplier.
       */
      match /suppliers/{supplierId} {
        allow get: if isBarberShopOwner(barberShopId);
        allow list: if isBarberShopOwner(barberShopId);
        allow create: if isBarberShopOwner(barberShopId);
        allow update: if isExistingBarberShopOwner(barberShopId);
        allow delete: if isExistingBarberShopOwner(barberShopId);
      }

      /**
       * @description Allows the owner of a barber shop to manage financial record data for their shop.
       * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
       * @allow (create) Owner of barberShopId can create a financial record.
       * @allow (get) Owner of barberShopId can read a financial record.
       * @allow (update) Owner of barberShopId can update a financial record.
       * @allow (delete) Owner of barberShopId can delete a financial record.
       * @deny (create) Non-owner of barberShopId cannot create a financial record.
       * @deny (get) Non-owner of barberShopId cannot read a financial record.
       * @principle Enforces ownership via the barberShopId path.
       */
      match /financialRecords/{financialRecordId} {
        allow get: if isBarberShopOwner(barberShopId);
        allow list: if isBarberShopOwner(barberShopId);
        allow create: if isBarberShopOwner(barberShopId);
        allow update: if isExistingBarberShopOwner(barberShopId);
        allow delete: if isExistingBarberShopOwner(barberShopId);
      }
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the given userId.
     * @param {string} userId The user ID to check.
     * @return {boolean} True if the current user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the barber shop.
     * @param {string} barberShopId The barber shop ID to check.
     * @return {boolean} True if the current user is the owner, false otherwise.
     */
    function isBarberShopOwner(barberShopId) {
      return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

     /**
      * @description Checks if the current user is the owner of the barber shop, and if the document exists.
      * @param {string} barberShopId The barber shop ID to check.
      * @return {boolean} True if the current user is the owner and the document exists, false otherwise.
      */
    function isExistingBarberShopOwner(barberShopId) {
      return isBarberShopOwner(barberShopId) && exists(/databases/$(database)/documents/barberShops/$(barberShopId));
    }

    /**
     * @description Checks if the current user is the owner and if the resource exists.
     * @param {string} userId The user ID to check.
     * @return {boolean} True if the user is the owner and resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      // Path to the user's document in the /users collection
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      // Checks if the user has a custom claim 'admin' set to true
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function ownsBarberShop(barberShopId) {
      return isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
    }

    // =============================================
    // GLOBAL RULES (ADMIN OVERRIDE)
    // =============================================
    match /{document=**} {
      // Admins have god-mode access
      allow read, write: if isAdmin();
    }
    
    // =============================================
    // USER-SPECIFIC RULES
    // =============================================
    match /users/{userId} {
      // Allow any authenticated user to LIST users to check if an admin exists during setup.
      // Individual user documents are still protected by the 'get' rule below.
      allow list: if isSignedIn();
      
      // Allow a user to read their own document.
      allow get: if isOwner(userId);
      
      // Allow a user to create their own document (e.g., on signup).
      // The request.resource.data.id must match the user's UID to prevent spoofing.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      
      // Allow a user to update their own document, but NOT change their role.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      
      // Disallow deletion of user documents by users themselves.
      allow delete: if false;
    }

    // =============================================
    // BARBERSHOP RULES (MULTI-TENANT)
    // =============================================
    match /barberShops/{barberShopId} {
      // Any authenticated user can create a new shop.
      allow create: if isSignedIn();
      
      // Only the owner can read, update, or delete their own shop.
      allow read, update, delete: if ownsBarberShop(barberShopId);
      
      // Rules for all subcollections within a barber shop
      match /{collection}/{docId} {
        allow read, write: if ownsBarberShop(barberShopId);
      }
    }
    
    // =============================================
    // ADMIN LOGS
    // =============================================
    match /adminLogs/{logId} {
      // Allow any authenticated user to create a log entry. This is necessary to
      // log failed login attempts before a user's role is confirmed.
      allow create: if isSignedIn();
      
      // Only admins can read the logs.
      allow read, list: if isAdmin();
      
      // Logs are immutable; they cannot be updated or deleted.
      allow update, delete: if false;
    }
    
    // =============================================
    // SUPPORT TICKETS & LEGAL DOCS
    // =============================================
    match /tickets/{ticketId} {
        // Owner can create, admin can read/write
        allow create: if isSignedIn();
        allow read, update: if isAdmin();
        allow delete: if false;
    }
    
    match /documents/{docId} {
        // Public read, admin write
        allow get: if true;
        allow list, write: if isAdmin();
    }
  }
}

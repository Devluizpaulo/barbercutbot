/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for barber shop data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /barberShops/{barberShopId}: Stores barber shop data, accessible only to the shop owner. The owner is determined by the `ownerId` field in the document.
 * - /barberShops/{barberShopId}/customers/{customerId}: Stores customer data, accessible only to the shop owner.
 * - /barberShops/{barberShopId}/barbers/{barberId}: Stores barber data, accessible only to the shop owner.
 * - /barberShops/{barberShopId}/appointments/{appointmentId}: Stores appointment data, accessible only to the shop owner.
 * - /barberShops/{barberShopId}/services/{serviceId}: Stores service data, accessible only to the shop owner.
 * - /barberShops/{barberShopId}/suppliers/{supplierId}: Stores supplier data, accessible only to the shop owner.
 * - /barberShops/{barberShopId}/financialRecords/{financialRecordId}: Stores financial records, accessible only to the shop owner.
 *
 * Key Security Decisions:
 * - User data is private and only accessible to the authenticated user.
 * - Barber shop data and all its subcollections are only accessible to the barber shop owner.
 * - The rules explicitly deny listing of user documents to prevent unauthorized access to user data.
 * - All write operations are protected by authorization checks to ensure data integrity and prevent unauthorized modifications.
 *
 * Denormalization for Authorization:
 * - The `ownerId` field in the `/barberShops/{barberShopId}` document allows for direct ownership checks without additional reads.
 * - Subcollections under `/barberShops/{barberShopId}` implicitly denormalize the `barberShopId` by path to make secure list operations simpler and more efficient.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile.
     * @allow (get) User with UID 'user123' can get their profile.
     * @allow (update) User with UID 'user123' can update their profile.
     * @allow (delete) User with UID 'user123' can delete their profile.
     * @deny (create) User with UID 'user456' cannot create a profile for user 'user123'.
     * @deny (get) User with UID 'user456' cannot get the profile for user 'user123'.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure barber shop data.
     * @path /barberShops/{barberShopId}
     * @allow (create) User with UID 'user123' can create a barber shop with ownerId 'user123'.
     * @allow (get) User with UID 'user123' can get a barber shop they own.
     * @allow (update) User with UID 'user123' can update a barber shop they own.
     * @allow (delete) User with UID 'user123' can delete a barber shop they own.
     * @deny (create) User with UID 'user456' cannot create a barber shop with ownerId 'user123'.
     * @deny (get) User with UID 'user456' cannot get a barber shop owned by 'user123'.
     * @principle Enforces document ownership for all operations on barber shop data.
     */
    match /barberShops/{barberShopId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Secure customer data for a specific barber shop.
     * @path /barberShops/{barberShopId}/customers/{customerId}
     * @allow (create) Owner of barberShopId 'shop123' can create a customer.
     * @allow (get) Owner of barberShopId 'shop123' can get a customer.
     * @allow (update) Owner of barberShopId 'shop123' can update a customer.
     * @allow (delete) Owner of barberShopId 'shop123' can delete a customer.
     * @deny (create) User who is not the owner of barberShopId 'shop123' cannot create a customer.
     * @deny (get) User who is not the owner of barberShopId 'shop123' cannot get a customer.
     * @principle Enforces ownership based on the barberShopId path.
     */
    match /barberShops/{barberShopId}/customers/{customerId} {
      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      function isExistingBarberShopOwner(barberShopId) {
        return isBarberShopOwner(barberShopId) && resource != null;
      }

      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure barber data for a specific barber shop.
     * @path /barberShops/{barberShopId}/barbers/{barberId}
     * @allow (create) Owner of barberShopId 'shop123' can create a barber.
     * @allow (get) Owner of barberShopId 'shop123' can get a barber.
     * @allow (update) Owner of barberShopId 'shop123' can update a barber.
     * @allow (delete) Owner of barberShopId 'shop123' can delete a barber.
     * @deny (create) User who is not the owner of barberShopId 'shop123' cannot create a barber.
     * @deny (get) User who is not the owner of barberShopId 'shop123' cannot get a barber.
     * @principle Enforces ownership based on the barberShopId path.
     */
    match /barberShops/{barberShopId}/barbers/{barberId} {
      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      function isExistingBarberShopOwner(barberShopId) {
        return isBarberShopOwner(barberShopId) && resource != null;
      }

      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure appointment data for a specific barber shop.
     * @path /barberShops/{barberShopId}/appointments/{appointmentId}
     * @allow (create) Owner of barberShopId 'shop123' can create an appointment.
     * @allow (get) Owner of barberShopId 'shop123' can get an appointment.
     * @allow (update) Owner of barberShopId 'shop123' can update an appointment.
     * @allow (delete) Owner of barberShopId 'shop123' can delete an appointment.
     * @deny (create) User who is not the owner of barberShopId 'shop123' cannot create an appointment.
     * @deny (get) User who is not the owner of barberShopId 'shop123' cannot get an appointment.
     * @principle Enforces ownership based on the barberShopId path.
     */
    match /barberShops/{barberShopId}/appointments/{appointmentId} {
      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      function isExistingBarberShopOwner(barberShopId) {
        return isBarberShopOwner(barberShopId) && resource != null;
      }

      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure service data for a specific barber shop.
     * @path /barberShops/{barberShopId}/services/{serviceId}
     * @allow (create) Owner of barberShopId 'shop123' can create a service.
     * @allow (get) Owner of barberShopId 'shop123' can get a service.
     * @allow (update) Owner of barberShopId 'shop123' can update a service.
     * @allow (delete) Owner of barberShopId 'shop123' can delete a service.
     * @deny (create) User who is not the owner of barberShopId 'shop123' cannot create a service.
     * @deny (get) User who is not the owner of barberShopId 'shop123' cannot get a service.
     * @principle Enforces ownership based on the barberShopId path.
     */
    match /barberShops/{barberShopId}/services/{serviceId} {
      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      function isExistingBarberShopOwner(barberShopId) {
        return isBarberShopOwner(barberShopId) && resource != null;
      }

      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure supplier data for a specific barber shop.
     * @path /barberShops/{barberShopId}/suppliers/{supplierId}
     * @allow (create) Owner of barberShopId 'shop123' can create a supplier.
     * @allow (get) Owner of barberShopId 'shop123' can get a supplier.
     * @allow (update) Owner of barberShopId 'shop123' can update a supplier.
     * @allow (delete) Owner of barberShopId 'shop123' can delete a supplier.
     * @deny (create) User who is not the owner of barberShopId 'shop123' cannot create a supplier.
     * @deny (get) User who is not the owner of barberShopId 'shop123' cannot get a supplier.
     * @principle Enforces ownership based on the barberShopId path.
     */
    match /barberShops/{barberShopId}/suppliers/{supplierId} {
      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      function isExistingBarberShopOwner(barberShopId) {
        return isBarberShopOwner(barberShopId) && resource != null;
      }

      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);
    }

    /**
     * @description Secure financial record data for a specific barber shop.
     * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
     * @allow (create) Owner of barberShopId 'shop123' can create a financial record.
     * @allow (get) Owner of barberShopId 'shop123' can get a financial record.
     * @allow (update) Owner of barberShopId 'shop123' can update a financial record.
     * @allow (delete) Owner of barberShopId 'shop123' can delete a financial record.
     * @deny (create) User who is not the owner of barberShopId 'shop123' cannot create a financial record.
     * @deny (get) User who is not the owner of barberShopId 'shop123' cannot get a financial record.
     * @principle Enforces ownership based on the barberShopId path.
     */
    match /barberShops/{barberShopId}/financialRecords/{financialRecordId} {
      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      function isExistingBarberShopOwner(barberShopId) {
        return isBarberShopOwner(barberShopId) && resource != null;
      }

      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);
    }

    /**
     * @description Team members of a specific barber shop.
     * @path /barberShops/{barberShopId}/teamMembers/{teamMemberId}
     * @allow (list) Owner of barberShopId 'shop123' can list the team members.
     * @principle Enforces ownership based on the barberShopId path.
     */
    match /barberShops/{barberShopId}/teamMembers/{teamMemberId} {
      function isBarberShopOwner(barberShopId) {
        return get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
      }

      function isExistingBarberShopOwner(barberShopId) {
        return isBarberShopOwner(barberShopId) && resource != null;
      }

      allow get: if isBarberShopOwner(barberShopId);
      allow list: if isBarberShopOwner(barberShopId);
      allow create: if isBarberShopOwner(barberShopId);
      allow update: if isExistingBarberShopOwner(barberShopId);
      allow delete: if isExistingBarberShopOwner(barberShopId);
    }
  }
}
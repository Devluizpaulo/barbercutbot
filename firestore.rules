/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset enforces a multi-tenant security model for a Barber Shop SaaS application.
 * Data is primarily isolated by BarberShop, with User ownership of BarberShops.
 * @data-structure
 * - /users/{userId}: User profile data, owned by the user.
 * - /admins/{adminId}: Admin user list.
 * - /barberShops/{barberShopId}: Barber shop data, owned by a user via the ownerId field.
 * - /barberShops/{barberShopId}/{subcollections}: Data related to a specific barber shop (customers, barbers, appointments, services, suppliers, financialRecords, products).
 * - /tickets/{ticketId}: Support tickets from all users/shops.
 * - /documents/{documentId}: Platform-wide legal documents.
 * @key-security-decisions
 * - Users can only access their own user document.
 * - BarberShop data access is restricted to the BarberShop owner.
 * - Subcollections under BarberShop are only accessible to the BarberShop owner.
 * - Listing users is disallowed for privacy.
 * - All write operations require authentication.
 * @denormalization-for-authorization The `barberShopId` is implicitly denormalized by the path on all subcollections nested under `/barberShops/{barberShopId}`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     * @returns {boolean} True if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the resource, based on the userId.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @returns {boolean} True if the user is the owner.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the owner of the resource AND the resource exists.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @returns {boolean} True if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Matches the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own document.
     * @allow (get) If the user is requesting their own document.
     * @allow (update) If the user is updating their own document.
     * @allow (delete) If the user is deleting their own document.
     * @deny (create) If the user is not authenticated.
     * @deny (get) If the user is not authenticated.
     * @deny (update) If the user is not authenticated.
     * @deny (delete) If the user is not authenticated.
     * @deny (list) Listing users is not allowed.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Matches the /admins/{adminId} collection.
     * @path /admins/{adminId}
     * @allow (create) Admins can only be created via backend functions.
     * @allow (get) Only admins can read the list of admins.
     * @allow (update) Admins can only be updated via backend functions.
     * @allow (delete) Admins can only be deleted via backend functions.
     * @deny (list) Listing admins is not allowed.
     * @principle Restricts admin management to backend functions.
     */
    match /admins/{adminId} {
        allow get: if false; // TODO: Implement admin role check via custom claims
        allow list: if false;

        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Matches the /barberShops/{barberShopId} collection.
     * @path /barberShops/{barberShopId}
     * @allow (create) If the user is creating a barberShop and owns it via `ownerId`.
     * @allow (get) If the user is the owner of the barberShop.
     * @allow (update) If the user is the owner of the barberShop.
     * @allow (delete) If the user is the owner of the barberShop.
     * @deny (list) Listing all barberShops is not allowed.
     * @principle Enforces ownership via the `ownerId` field.
     */
    match /barberShops/{barberShopId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.id == barberShopId;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && resource != null && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid && resource != null;

      /**
       * @description Matches the /barberShops/{barberShopId}/products/{productId} collection.
       * @path /barberShops/{barberShopId}/products/{productId}
       * @allow (create) If the user is the owner of the barberShop.
       * @allow (get) If the user is the owner of the barberShop.
       * @allow (update) If the user is the owner of the barberShop.
       * @allow (delete) If the user is the owner of the barberShop.
       * @principle Enforces ownership of the barberShop for product management.
       */
      match /products/{productId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Matches the /barberShops/{barberShopId}/customers/{customerId} collection.
       * @path /barberShops/{barberShopId}/customers/{customerId}
       * @allow (create) If the user is the owner of the barberShop.
       * @allow (get) If the user is the owner of the barberShop.
       * @allow (update) If the user is the owner of the barberShop.
       * @allow (delete) If the user is the owner of the barberShop.
       * @principle Enforces ownership of the barberShop for customer management.
       */
      match /customers/{customerId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Matches the /barberShops/{barberShopId}/barbers/{barberId} collection.
       * @path /barberShops/{barberShopId}/barbers/{barberId}
       * @allow (create) If the user is the owner of the barberShop.
       * @allow (get) If the user is the owner of the barberShop.
       * @allow (update) If the user is the owner of the barberShop.
       * @allow (delete) If the user is the owner of the barberShop.
       * @principle Enforces ownership of the barberShop for barber management.
       */
      match /barbers/{barberId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Matches the /barberShops/{barberShopId}/appointments/{appointmentId} collection.
       * @path /barberShops/{barberShopId}/appointments/{appointmentId}
       * @allow (create) If the user is the owner of the barberShop.
       * @allow (get) If the user is the owner of the barberShop.
       * @allow (update) If the user is the owner of the barberShop.
       * @allow (delete) If the user is the owner of the barberShop.
       * @principle Enforces ownership of the barberShop for appointment management.
       */
      match /appointments/{appointmentId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Matches the /barberShops/{barberShopId}/services/{serviceId} collection.
       * @path /barberShops/{barberShopId}/services/{serviceId}
       * @allow (create) If the user is the owner of the barberShop.
       * @allow (get) If the user is the owner of the barberShop.
       * @allow (update) If the user is the owner of the barberShop.
       * @allow (delete) If the user is the owner of the barberShop.
       * @principle Enforces ownership of the barberShop for service management.
       */
      match /services/{serviceId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Matches the /barberShops/{barberShopId}/suppliers/{supplierId} collection.
       * @path /barberShops/{barberShopId}/suppliers/{supplierId}
       * @allow (create) If the user is the owner of the barberShop.
       * @allow (get) If the user is the owner of the barberShop.
       * @allow (update) If the user is the owner of the barberShop.
       * @allow (delete) If the user is the owner of the barberShop.
       * @principle Enforces ownership of the barberShop for supplier management.
       */
      match /suppliers/{supplierId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }

      /**
       * @description Matches the /barberShops/{barberShopId}/financialRecords/{financialRecordId} collection.
       * @path /barberShops/{barberShopId}/financialRecords/{financialRecordId}
       * @allow (create) If the user is the owner of the barberShop.
       * @allow (get) If the user is the owner of the barberShop.
       * @allow (update) If the user is the owner of the barberShop.
       * @allow (delete) If the user is the owner of the barberShop.
       * @principle Enforces ownership of the barberShop for financial record management.
       */
      match /financialRecords/{financialRecordId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/barberShops/$(barberShopId)).data.ownerId == request.auth.uid && resource != null;
      }
    }

        /**
         * @description Matches the /tickets/{ticketId} collection.
         * @path /tickets/{ticketId}
         * @allow (get) Anyone can read a ticket.
         * @allow (list) Nobody can list tickets.
         * @allow (create) Anyone can create a ticket.
         * @allow (update) Only admins can update a ticket.
         * @allow (delete) Only admins can delete a ticket.
         * @principle Public read, admin write for tickets.
         */
        match /tickets/{ticketId} {
            allow get: if true;
            allow list: if false;

            allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
            allow update: if false; // TODO: Implement admin role check via custom claims && resource != null;
            allow delete: if false; // TODO: Implement admin role check via custom claims && resource != null;
        }

        /**
         * @description Matches the /documents/{documentId} collection.
         * @path /documents/{documentId}
         * @allow (get) Anyone can read a document.
         * @allow (list) Anyone can list documents.
         * @allow (create) Only admins can create documents.
         * @allow (update) Only admins can update documents.
         * @allow (delete) Only admins can delete documents.
         * @principle Public read, admin write for platform documents.
         */
        match /documents/{documentId} {
            allow get: if true;
            allow list: if true;

            allow create: if false; // TODO: Implement admin role check via custom claims
            allow update: if false; // TODO: Implement admin role check via custom claims && resource != null;
            allow delete: if false; // TODO: Implement admin role check via custom claims && resource != null;
        }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Members subcollection: barberShops/{shopId}/members/{uid} -> { role: 'owner'|'manager'|'barber'|'staff' }
    function isShopMember(shopId) {
      return isSignedIn() && exists(/databases/$(database)/documents/barberShops/$(shopId)/members/$(request.auth.uid));
    }

    function getRole(shopId) {
      return isShopMember(shopId)
        ? get(/databases/$(database)/documents/barberShops/$(shopId)/members/$(request.auth.uid)).data.role
        : null;
    }

    function hasRole(shopId, role) {
      return isShopMember(shopId) && getRole(shopId) == role;
    }

    function isOwnerOrManager(shopId) {
      return hasRole(shopId, 'owner') || hasRole(shopId, 'manager');
    }

    // =============================================
    // ADMIN GOD-MODE (HIGHEST PRIORITY)
    // =============================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // =============================================
    // USER AND SHOP RULES
    // =============================================

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow get, update: if request.auth.uid == userId;
      allow list: if false; // block all list operations
    }

    match /barberShops/{shopId} {
      // Shop document CRUD guarded by roles
      allow create: if isSignedIn();
      allow get: if isShopMember(shopId);
      allow update, delete: if hasRole(shopId, 'owner');

      // Block lists entirely at this level. Use server-side endpoints instead.
      allow list: if false;
    }
    
    // =============================================
    // SUB-COLLECTION RULES WITH ROLES
    // =============================================

    match /barberShops/{shopId}/{subcollection}/{docId} {
        // Generic default: members can read single docs; writes reserved to owner/manager unless overridden below
        allow get: if isShopMember(shopId);
        allow create, update, delete: if isOwnerOrManager(shopId);
        allow list: if false; // all lists blocked
    }

    // Appointments with finer controls
    match /barberShops/{shopId}/appointments/{appointmentId} {
      allow get: if isShopMember(shopId);

      // owner/manager can write any appointment
      allow create, update, delete: if isOwnerOrManager(shopId);

      // staff can create/update (not delete)
      allow create: if hasRole(shopId, 'staff');
      allow update: if hasRole(shopId, 'staff');

      // barber can update only if involved in the appointment (barberIds contains their uid)
      allow update: if hasRole(shopId, 'barber') && (
        (request.resource.data.barberIds is list && request.auth.uid in request.resource.data.barberIds) ||
        (resource.data.barberIds is list && request.auth.uid in resource.data.barberIds)
      );

      // Data validation basics
      allow create, update: if
        request.resource.data.barberShopId == shopId
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.status in ['pending','confirmed','completed','cancelled','no-show'];
    }
    
    // =============================================
    // PLATFORM-WIDE COLLECTIONS
    // =============================================

    match /adminLogs/{logId} {
      allow create: if isSignedIn();
      allow get, update, delete: if isAdmin();
      allow list: if isAdmin(); // Only admins can list logs
    }

    match /tickets/{ticketId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow get, update: if request.auth.uid == get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId || isAdmin();
      allow delete: if isAdmin();

      // Admins can list all tickets.
      // Regular users can only list tickets they own.
      allow list: if isAdmin() || (isSignedIn() && request.query.where[0] == 'userId' && request.query.where[2] == request.auth.uid);
    }

    match /documents/{docId} {
      allow read: if true; // Public documents
      allow write: if isAdmin();
    }
  }
}

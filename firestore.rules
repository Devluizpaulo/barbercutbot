
/**
 * @file Firebase Security Rules for Firestore.
 *
 * @core_philosophy This ruleset enforces a strict owner-based access control model for barber shops and user profiles.
 *  It prioritizes security by default, restricting access unless explicitly granted. Data validation is minimized
 *  to allow for rapid prototyping and schema evolution.
 *
 * @data_structure The data is organized hierarchically, with user profiles stored under `/users/{userId}` and
 *  barber shop data stored under `/barberShops/{shopId}`.  Team member relationships are managed in the
 *  `/barberShops/{shopId}/team/{userId}` subcollection.
 *
 * @key_security_decisions
 *  - Listing of all users is disallowed. Only the authenticated user can access their own profile.
 *  - BarberShops are publicly listable but writes are owner-controlled.
 *  - Team members can only be managed by the shop owner.
 *  - All write operations are validated to ensure the document exists before modification or deletion to prevent accidental data loss.
 *  - The rules do not enforce strong schema validation (data types, required fields) in order to allow for faster iteration. The rules focus instead on authorization.
 *
 * @denormalization To avoid costly `get()` calls in the rules, the `BarberShop` entity contains an `ownerId` field. This allows the rules to quickly check ownership without needing to read another document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource, based on the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @returns {boolean} True if the user is the owner and resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user has admin privileges via custom claim
     *              or via users/{uid} document with role == 'admin'.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    /**
     * @description Function to check if the user is the owner of a specific shop.
     * @param {string} shopId - The ID of the barber shop to check.
     * @returns {boolean} True if the user is the owner of the shop, false otherwise.
     */
    function isShopOwner(shopId) {
        return isOwner(get(/databases/$(database)/documents/barberShops/$(shopId)).data.ownerId);
    }


    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - An authenticated user can create their own profile if the userId matches their auth UID.
     * @allow (get) - An authenticated user can read their own profile if the userId matches their auth UID.
     * @allow (update) - An authenticated user can update their own profile if the userId matches their auth UID.
     * @allow (delete) - An authenticated user can delete their own profile if the userId matches their auth UID.
     * @deny (create) - An unauthenticated user cannot create any user profile.
     * @deny (get) - An authenticated user cannot read another user's profile if the userId does not match their auth UID.
     * @deny (update) - An authenticated user cannot update another user's profile if the userId does not match their auth UID.
     * @deny (delete) - An authenticated user cannot delete another user's profile if the userId does not match their auth UID.
     * @principle Enforces user-ownership for all data access. Only the authenticated user can manage their own profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isExistingOwner(userId) || isAdmin()) && request.resource.data.id == resource.data.id; // Enforce immutability of userId.
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for barber shops.
     * @path /barberShops/{shopId}
     * @allow (create) - An authenticated user can create a barber shop and becomes the owner by setting the `ownerId` field.
     * @allow (get) - Anyone can read a barber shop's data.
     * @allow (list) - Anyone can list barber shops.
     * @allow (update) - Only the owner of the barber shop can update it.
     * @allow (delete) - Only the owner of the barber shop can delete it.
     * @deny (create) - An unauthenticated user cannot create a barber shop.
     * @deny (update) - An authenticated user cannot update a barber shop they do not own.
     * @deny (delete) - An authenticated user cannot delete a barber shop they do not own.
     * @principle Allows public read access but restricts write access to the owner.
     */
    match /barberShops/{shopId} {
      allow get: if isAdmin() || (resource != null && isOwner(resource.data.ownerId));
      allow list: if isAdmin() || (isSignedIn() && request.query.where.get('ownerId')[2] == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (resource != null && isOwner(resource.data.ownerId));
      allow delete: if isAdmin() || (resource != null && isOwner(resource.data.ownerId));

       // Generic rule for all subcollections within a barberShop
      match /{subcollection}/{docId} {
        allow read, write: if isShopOwner(shopId) || isAdmin();
      }
    }
    
    // Allow listing shops only for admin or when filtered by ownerId == current user
    match /barberShops {
      allow list: if isAdmin() || (isSignedIn() && request.query.where.get('ownerId')[2] == request.auth.uid);
    }

    /**
     * @description Rules for tickets.
     * @path /tickets/{ticketId}
     * @allow (create) - No rule defined: set to false to prevent all creation
     * @allow (get) - No rule defined: set to false to prevent all reads
     * @allow (list) - No rule defined: set to false to prevent all listing
     * @allow (update) - No rule defined: set to false to prevent all updates
     * @allow (delete) - No rule defined: set to false to prevent all deletions
     * @principle No rule defined: Deny All
     */
    match /tickets/{ticketId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for documents.
     * @path /documents/{documentId}
     * @allow (create) - No rule defined: set to false to prevent all creation
     * @allow (get) - No rule defined: set to false to prevent all reads
     * @allow (list) - No rule defined: set to false to prevent all listing
     * @allow (update) - No rule defined: set to false to prevent all updates
     * @allow (delete) - No rule defined: set to false to prevent all deletions
     * @principle No rule defined: Deny All
     */
    match /documents/{documentId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}

    
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permite que qualquer pessoa leia arquivos. Isso é necessário para que as imagens
    // (logos, fotos de perfil, etc.) possam ser exibidas publicamente no aplicativo.
    match /{allPaths=**} {
      allow read;
    }

    // Apenas usuários autenticados podem enviar arquivos, e somente para pastas
    // dentro de 'barberShops/{shopId}'. Isso impede que um usuário envie
    // arquivos para a pasta de outro negócio.
    match /barberShops/{shopId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
